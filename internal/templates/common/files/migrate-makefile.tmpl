MIGRATE_VERSION := v4.19.1
MIGRATIONS_DIR := migrations

# Load .env so the DSN below reuses the same connection settings the app uses.
ifneq (,$(wildcard .env))
include .env
export
endif

{{if eq .Database "postgres" -}}
MIGRATE_TAGS := postgres
DATABASE_URL := postgres://$(POSTGRES_USERNAME):$(POSTGRES_PASSWORD)@$(POSTGRES_HOST):$(POSTGRES_PORT)/$(POSTGRES_DATABASE)?sslmode=disable
{{- else if eq .Database "mysql" -}}
MIGRATE_TAGS := mysql
DATABASE_URL := mysql://$(MYSQL_USERNAME):$(MYSQL_PASSWORD)@tcp($(MYSQL_HOST):$(MYSQL_PORT))/$(MYSQL_DATABASE)
{{- else if eq .Database "mariadb" -}}
MIGRATE_TAGS := mysql
DATABASE_URL := mysql://$(MARIADB_USERNAME):$(MARIADB_PASSWORD)@tcp($(MARIADB_HOST):$(MARIADB_PORT))/$(MARIADB_DATABASE)
{{- else if eq .Database "sqlite" -}}
MIGRATE_TAGS := sqlite
DATABASE_URL := sqlite://$(SQLITE_DB_URL)
{{- end}}

# migrate: the golang-migrate CLI, pinned via `go run …@version` with the driver
# build tag, so it never enters this project's go.mod (matching `make lint`/`arch`).
# The first run compiles the tool (slow, one-time); later runs use the build cache.
MIGRATE := go run -tags '$(MIGRATE_TAGS)' github.com/golang-migrate/migrate/v4/cmd/migrate@$(MIGRATE_VERSION)

# migrate-up: apply every pending migration. Run this once before first boot — the
# app no longer creates its schema at startup.
migrate-up:
	@$(MIGRATE) -path $(MIGRATIONS_DIR) -database "$(DATABASE_URL)" up

# migrate-down: roll back the most recent migration.
migrate-down:
	@$(MIGRATE) -path $(MIGRATIONS_DIR) -database "$(DATABASE_URL)" down 1

# migrate-create: scaffold a new up/down pair, e.g. `make migrate-create name=add_email`.
migrate-create:
	@$(MIGRATE) create -ext sql -dir $(MIGRATIONS_DIR) -seq $(name)
