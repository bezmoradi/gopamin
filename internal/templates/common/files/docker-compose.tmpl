# Local development services. Every port is published on 127.0.0.1 only, so
# other machines on your network can't reach them, and the passwords in .env were
# generated for this project.
services:
{{- if eq .Database "postgres"}}
  psql:
    image: postgres:17
    environment:
      POSTGRES_DB: ${POSTGRES_DATABASE}
      POSTGRES_USER: ${POSTGRES_USERNAME}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "127.0.0.1:${POSTGRES_PORT}:5432"
    volumes:
      - psql_volume:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USERNAME} -d ${POSTGRES_DATABASE}"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .Database "mysql"}}
  mysql:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USERNAME}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    ports:
      - "127.0.0.1:${MYSQL_PORT}:3306"
    volumes:
      - mysql_volume:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
{{- else if eq .Database "mariadb"}}
  mariadb:
    image: mariadb:11.4
    environment:
      MYSQL_DATABASE: ${MARIADB_DATABASE}
      MYSQL_USER: ${MARIADB_USERNAME}
      MYSQL_PASSWORD: ${MARIADB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD}
    ports:
      - "127.0.0.1:${MARIADB_PORT}:3306"
    volumes:
      - mariadb_volume:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
{{- else if eq .Database "mongodb"}}
  mongo:
    image: mongo:7
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGODB_USERNAME}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGODB_PASSWORD}
    ports:
      - "127.0.0.1:${MONGODB_PORT}:27017"
    volumes:
      - mongo_volume:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
{{- else if eq .Database "cassandra"}}
  cassandra:
    image: cassandra:5.0
    ports:
      - "127.0.0.1:${CASSANDRA_PORT}:9042"
    volumes:
      - cassandra_volume:/var/lib/cassandra
    healthcheck:
      # A CQL query, not `nodetool status`: the node reports UN before port 9042
      # accepts clients.
      test: ["CMD-SHELL", "cqlsh -e 'DESCRIBE KEYSPACES' > /dev/null"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 60s
{{- else if eq .Database "dynamodb"}}
  dynamodb:
    image: "amazon/dynamodb-local:2.5.2"
    command: "-jar DynamoDBLocal.jar -sharedDb -dbPath ./data"
    working_dir: /home/dynamodblocal
    # The image's user (uid 1000) can't write the data directory: Docker creates a
    # new volume, like a missing bind directory, owned by root.
    user: root
    ports:
      - "127.0.0.1:8000:8000"
    volumes:
      - dynamodb_volume:/home/dynamodblocal/data
    healthcheck:
      # A real ListTables call (DynamoDB Local accepts any credentials): the port
      # answers before the first request can be served.
      test: ["CMD-SHELL", "curl -s -X POST http://localhost:8000 -H 'Content-Type: application/x-amz-json-1.0' -H 'X-Amz-Target: DynamoDB_20120810.ListTables' -H 'Authorization: AWS4-HMAC-SHA256 Credential=local/20200101/us-east-1/dynamodb/aws4_request, SignedHeaders=host, Signature=0' -d '{}' | grep -q TableNames"]
      interval: 5s
      timeout: 5s
      retries: 12
{{- end}}
{{- if eq .Broker "kafka"}}
  kafka:
    image: apache/kafka:3.9.0
    ports:
      - "127.0.0.1:${KAFKA_PORT}:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:${KAFKA_PORT}
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 20s
{{- else if eq .Broker "rabbitmq"}}
  rabbitmq:
    image: rabbitmq:4.4-management
    ports:
      - "127.0.0.1:${RABBITMQ_PORT}:5672"
      - "127.0.0.1:${RABBITMQ_MANAGEMENT_PORT}:15672"
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD}
    healthcheck:
      # Connect to the AMQP port itself: the node answers `rabbitmq-diagnostics
      # ping` seconds before the listener accepts connections. Not the CLI at
      # all: run as root before the broker has written its Erlang cookie, it
      # writes one the broker can't read, and the broker exits.
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/5672"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 20s
{{- else if eq .Broker "redis"}}
  redis:
    image: redis:7.4
    command: redis-server --requirepass ${REDIS_PASSWORD}
    ports:
      - "127.0.0.1:${REDIS_PORT}:6379"
    volumes:
      - redis_volume:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a ${REDIS_PASSWORD} ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end}}
{{- if .Observability}}
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.128.0
    command: ["--config=/etc/otel/config.yaml"]
    volumes:
      - ./configs/otel-collector.yaml:/etc/otel/config.yaml
    ports:
      - "127.0.0.1:4317:4317" # OTLP gRPC
      - "127.0.0.1:4318:4318" # OTLP HTTP
{{- end}}
{{- if or (eq .Database "postgres") (eq .Database "mysql") (eq .Database "mariadb") (eq .Database "mongodb") (eq .Database "cassandra") (eq .Database "dynamodb") (eq .Broker "redis")}}

volumes:
{{- if eq .Database "postgres"}}
  psql_volume:
{{- else if eq .Database "mysql"}}
  mysql_volume:
{{- else if eq .Database "mariadb"}}
  mariadb_volume:
{{- else if eq .Database "mongodb"}}
  mongo_volume:
{{- else if eq .Database "cassandra"}}
  cassandra_volume:
{{- else if eq .Database "dynamodb"}}
  dynamodb_volume:
{{- end}}
{{- if eq .Broker "redis"}}
  redis_volume:
{{- end}}
{{- end}}
