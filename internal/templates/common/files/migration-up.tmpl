{{- /* event_id (worker only) lets InsertOnce record a consumed event once. */ -}}
{{if eq .Database "postgres" -}}
CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100){{if eq .ProjectType "worker"}},
    event_id VARCHAR(36) UNIQUE{{end}}
);
{{- else if eq .Database "sqlite" -}}
CREATE TABLE IF NOT EXISTS users (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT{{if eq .ProjectType "worker"}},
    event_id TEXT UNIQUE{{end}}
);
{{- else -}}
CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100){{if eq .ProjectType "worker"}},
    event_id VARCHAR(36) UNIQUE{{end}}
);
{{- end}}
