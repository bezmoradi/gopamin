package main

import (
	{{- if .Broker}}
	"context"
	"os"
	"os/signal"
	"sync"
	"syscall"
	{{- end}}
	"{{.Name}}/cmd/server"
	"{{.Name}}/configs"
	{{- if .Broker}}
	"{{.Name}}/internal/adapters/brokers/{{.Broker}}"
	{{- end}}
{{- if .Database}}
	"{{.Name}}/internal/adapters/handlers/health"
{{- end}}
	"{{.Name}}/internal/adapters/handlers/{{.Platform}}"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/adapters/repositories/{{if .Database}}{{.Database}}{{else}}mock{{end}}"
	"{{.Name}}/internal/core/user/services"
)

func init() {
	configs.LoadEnv()
}

func main() {
	logger := {{.Logger}}.New()
{{- if .Database}}
	db, err := {{.Database}}.New()
	if err != nil {
		logger.Fatal(err)
	}
	defer func() { _ = db.Close() }()
{{- else}}
	db := &mock.MockRepository{}
{{- end}}
{{- if .Broker}}
	broker, err := {{.Broker}}.New("testing", logger)
	if err != nil {
		logger.Fatal(err)
	}
	defer func() { _ = broker.Close() }()

	service := services.NewUserService(db).WithPublisher(broker)

	// The consumer runs alongside the HTTP server; bind it to a signal context so
	// Ctrl+C / SIGTERM unblocks Consume and it drains instead of being killed
	// mid-message. The HTTP server manages its own shutdown inside server.Serve.
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// Consumer side: process events off the broker alongside the HTTP server. The
	// WaitGroup lets main wait for in-flight processing to finish on shutdown,
	// matching the worker type.
	var wg sync.WaitGroup
	wg.Go(func() {
		if err := broker.Consume(ctx, func(value []byte) {
			logger.Info("event received", "payload", string(value))
		}); err != nil && ctx.Err() == nil {
			logger.Error(err.Error())
		}
	})
{{- else}}
	service := services.NewUserService(db)
{{- end}}
{{- if eq .Platform "graphql"}}
	server.Serve({{.Platform}}.NewHandler(service, logger), logger{{if .Database}}, health.Check{Name: "database", Probe: db.Ping}{{end}})
{{- else}}
	server.Serve({{.Platform}}.NewRouter(service, logger), logger{{if .Database}}, health.Check{Name: "database", Probe: db.Ping}{{end}})
{{- end}}
{{- if .Broker}}
	// Serve returns only once a signal drained the HTTP server; that same signal
	// cancelled ctx, so Consume has stopped. Join it so an in-flight message finishes.
	wg.Wait()
{{- end}}
}
