package main

import (
	"context"
{{- if .Broker}}
	"errors"
	"fmt"
{{- end}}
	"os"
	"os/signal"
{{- if .Broker}}
	"sync"
{{- end}}
	"syscall"

	"{{.Name}}/cmd/server"
	"{{.Name}}/configs"
{{- if .Broker}}
	"{{.Name}}/internal/adapters/brokers/{{.Broker}}"
	"{{.Name}}/internal/adapters/events"
{{- end}}
{{- if .Database}}
	"{{.Name}}/internal/adapters/handlers/health"
{{- end}}
	"{{.Name}}/internal/adapters/handlers/{{.Platform}}"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/adapters/repositories/{{if .Database}}{{.Database}}{{else}}mock{{end}}"
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/services"
)

func init() {
	configs.LoadEnv()
}

func main() {
	logger := {{.Logger}}.New()
	if err := run(logger); err != nil {
		logger.Fatal(err)
	}
}

// run wires the app and serves until SIGINT/SIGTERM{{if .Broker}} or until the event
// consumer fails{{end}}. It returns instead of exiting, so the deferred Close calls run.
func run(logger shared.Logger) error {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
{{- if .Database}}

	db, err := {{.Database}}.New()
	if err != nil {
		return err
	}
	defer func() { _ = db.Close() }()
{{- else}}

	db := &mock.MockRepository{}
{{- end}}
{{- if .Broker}}

	broker, err := {{.Broker}}.New()
	if err != nil {
		return err
	}
	defer func() { _ = broker.Close() }()

	service := services.NewUserService(db).WithPublisher(events.NewPublisher(broker))

	// The consumer runs alongside the HTTP server. If it fails, cancelling ctx
	// drains the server and run returns the error, so the process exits 1 and
	// its supervisor restarts it, rather than serving with a dead consumer.
	ctx, cancel := context.WithCancelCause(ctx)
	defer cancel(nil)
	var wg sync.WaitGroup
	wg.Go(func() {
		if err := broker.Consume(ctx, handleEvent(logger)); err != nil {
			cancel(fmt.Errorf("event consumer: %w", err))
		}
	})
{{- else}}

	service := services.NewUserService(db)
{{- end}}

	serveErr := server.Serve(ctx, {{.Platform}}.{{if eq .Platform "graphql"}}NewHandler{{else}}NewRouter{{end}}(service, logger), logger{{if .Database}}, health.Check{Name: "database", Probe: db.Ping}{{end}})
{{- if .Broker}}

	// Stop the consumer and let it finish the message in hand.
	cancel(nil)
	wg.Wait()
	if cause := context.Cause(ctx); serveErr == nil && !errors.Is(cause, context.Canceled) {
		return cause
	}
{{- end}}
	return serveErr
}
{{- if .Broker}}

// handleEvent logs each event the service consumes: its type, id and size, never
// the payload, which carries a user's name. A message that isn't an event is
// logged and dropped, since retrying can't fix it.
func handleEvent(logger shared.Logger) func(context.Context, []byte) error {
	return func(_ context.Context, body []byte) error {
		envelope, err := events.Decode(body)
		if err != nil {
			logger.Error("dropping malformed event", "error", err, "bytes", len(body))
			return nil
		}
		logger.Info("event received", "type", envelope.Type, "id", envelope.ID, "bytes", len(body))
		return nil
	}
}
{{- end}}
