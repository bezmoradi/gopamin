package server

import (
	"context"
	"fmt"
	"net/http"
	"os"
{{- if and .Observability (ne .Platform "graphql")}}
	"strings"
{{- end}}
	"time"

{{- if .OpenAPI}}
	"{{.Name}}/internal/adapters/api"
{{- end}}
{{- if .Auth}}
	"{{.Name}}/internal/adapters/handlers/auth"
{{- end}}
	"{{.Name}}/internal/adapters/handlers/health"
	"{{.Name}}/internal/adapters/handlers/middleware"
	"{{.Name}}/internal/core/shared"
{{- if .Observability}}
	"{{.Name}}/internal/adapters/observability"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
{{- end}}
)

// Serve mounts the application handler behind the shared middleware chain, next
// to the health probes, and runs the server until ctx ends, then drains it. checks
// are the dependencies /readyz probes. It returns an error if the server can't
// start or stops unexpectedly.
func Serve(ctx context.Context, app http.Handler, logger shared.Logger, checks ...health.Check) error {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

{{- if .Observability}}
	// Initialize OpenTelemetry (OTLP export from the OTEL_* env). The deferred
	// shutdown is registered first so it runs LAST — after the server drains below —
	// flushing buffered spans/metrics. Fail-open: a setup error is logged, not fatal.
	otelShutdown, err := observability.Setup(context.Background())
	if err != nil {
		logger.Error("otel setup failed; continuing without telemetry", "error", err)
	}
	defer func() {
		flushCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = otelShutdown(flushCtx)
	}()
{{- end}}

{{- if .Auth}}
	// Auth config, read here like PORT (no config threaded through main). The
	// JWT_*/AUTH_* values live in .env; LoadConfig refuses missing, short or demo
	// values, so a deployment without its secrets stops here instead of serving
	// with authentication disabled.
	authConfig, err := auth.LoadConfig()
	if err != nil {
		return fmt.Errorf("auth config: %w", err)
	}
{{- end}}

	// Browsers may call the app cross-origin only from CORS_ALLOWED_ORIGINS; the
	// same list is trusted by the cross-origin (CSRF) protection.
	allowedOrigins := middleware.AllowedOrigins()
	crossOrigin, err := middleware.CrossOrigin(allowedOrigins)
	if err != nil {
		return err
	}

	// Mount liveness/readiness at the transport layer so they work regardless of
	// the HTTP framework, then delegate the application routes to it.
	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", health.Live)
	mux.HandleFunc("/readyz", health.Ready(logger, checks...))
{{- if .OpenAPI}}
	// API docs: the raw spec plus embedded Swagger UI, both self-contained.
	mux.HandleFunc("/openapi.yaml", api.SpecHandler())
	mux.Handle("/swagger/", api.SwaggerUIHandler())
{{- end}}
{{- if .Auth}}
	// /login is public and browser-facing, so it rides its own chain rather than
	// the bare mux — the application routes are then protected by the auth
	// middleware below.
	mux.Handle("/login", {{if .Observability}}otelhttp.NewHandler({{end}}middleware.Chain(
		auth.LoginHandler(authConfig, logger),
		middleware.Recover(logger),
		middleware.RequestLogger(logger),
		middleware.CORS(allowedOrigins),
		crossOrigin,
		middleware.MaxBytes(middleware.MaxBodyBytes),
		middleware.RequireJSON,
	){{if .Observability}}, "login"){{end}})
{{- end}}
	mux.Handle("{{if eq .Platform "graphql"}}/graphql{{else}}/{{end}}", {{if .Observability}}otelhttp.NewHandler({{end}}middleware.Chain(
		app,
		middleware.Recover(logger),
		middleware.RequestLogger(logger),
		middleware.CORS(allowedOrigins),
		crossOrigin,
		middleware.MaxBytes(middleware.MaxBodyBytes),
{{- if .Auth}}
		auth.Middleware(authConfig),
{{- end}}
{{- if eq .ProjectType "api"}}
		middleware.RequireJSON,
{{- end}}
		middleware.Timeout(10*time.Second),
	){{if .Observability}}, "http.server"{{if ne .Platform "graphql"}}, otelhttp.WithSpanNameFormatter(spanName){{end}}){{end}})

	server := &http.Server{
		Addr:         fmt.Sprintf(":%v", port),
		Handler:      middleware.SecurityHeaders(mux),
		IdleTimeout:  time.Minute,
		ReadTimeout:  10 * time.Second,
		WriteTimeout: 30 * time.Second,
	}

{{- if eq .Platform "graphql"}}
	logger.Info(fmt.Sprintf("The GraphQL server is accessible at http://localhost:%s/graphql", port))
{{- else if eq .ProjectType "web-app"}}
	logger.Info(fmt.Sprintf("The web server is accessible at http://localhost:%s/users", port))
{{- else}}
	logger.Info(fmt.Sprintf("The API is accessible at http://localhost:%s/api/v1/users", port))
{{- end}}
	// ListenAndServe only returns before Shutdown on a failure, such as the port
	// being taken.
	serveErr := make(chan error, 1)
	go func() { serveErr <- server.ListenAndServe() }()

	select {
	case err := <-serveErr:
		return err
	case <-ctx.Done():
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := server.Shutdown(shutdownCtx); err != nil {
		return fmt.Errorf("graceful shutdown: %w", err)
	}
	return nil
}
{{- if and .Observability (ne .Platform "graphql")}}

// spanName names each span after its route template. otelhttp otherwise derives
// the name from the mux pattern this handler is mounted on — "/" — so every
// request collapses into one "GET /" span and per-endpoint latency is unreadable.
//
// The route template is used rather than the raw path on purpose: span name is a
// low-cardinality dimension, so a distinct name per user id (or per scanner URL)
// would be a worse problem than the one being fixed. Everything unrouted folds
// into "/". Keep this in step with the routes registered in the handlers package.
func spanName(_ string, r *http.Request) string {
	return r.Method + " " + routeTemplate(r.URL.Path)
}

func routeTemplate(path string) string {
	const users = "{{if eq .ProjectType "web-app"}}/users{{else}}/api/v1/users{{end}}"

	switch {
	case path == users || path == users+"/":
		return users
	case strings.HasPrefix(path, users+"/"):
		return users + "/{id}"
{{- if eq .ProjectType "web-app"}}
	case strings.HasPrefix(path, "/assets/"):
		return "/assets/*"
{{- end}}
	default:
		return "/"
	}
}
{{- end}}
