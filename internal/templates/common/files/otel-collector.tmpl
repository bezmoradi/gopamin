# Minimal OpenTelemetry Collector config for local development. It receives OTLP
# from the app and prints a summary to its own logs (the `debug` exporter). Point
# it at a real backend by adding an exporter (e.g. otlp/otlphttp to Jaeger, Tempo,
# Prometheus, or a vendor) and listing it under the pipelines below.
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch: {}

exporters:
  debug:
    verbosity: detailed
  # Example — export traces to Jaeger's OTLP endpoint:
  # otlp/jaeger:
  #   endpoint: jaeger:4317
  #   tls:
  #     insecure: true

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [debug]
