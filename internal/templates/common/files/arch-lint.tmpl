{{- $hasCore := or (eq .ProjectType "api") (eq .ProjectType "web-app") (ne .Database "") -}}
{{- $hasHandlers := or (eq .ProjectType "api") (eq .ProjectType "web-app") -}}
{{- $hasApiResponse := and (eq .ProjectType "api") (ne .Platform "graphql") -}}
{{- $hasBrokers := ne .Broker "" -}}
{{- $hasWeb := eq .ProjectType "web-app" -}}
{{- /* Every project has a domain except a plain hello-world (no database), which
       ships only a logger adapter + its port. */ -}}
{{- $hasDomain := or (ne .ProjectType "hello-world") (ne .Database "") -}}
version: 3
workdir: .

# Architecture-boundary linter (go-arch-lint), generated by Gopamin. Enforces the
# Clean Architecture dependency rule (see AGENTS.md) mechanically: source-code
# dependencies point inward only. Run `make arch`. A violation fails the build —
# fix it by moving the code to the correct layer, NEVER by widening a rule here.
#
# Deny-by-default: every Go package must attach to a component below, so a new
# top-level package cannot silently escape the rules. Adapter categories use globs
# (handlers/*, repositories/*, loggers/*, brokers/*), so whichever single framework
# / database / logger / broker was chosen attaches without editing this file.

allow:
  # Keep false. The core (domain/ports/services) is granted NO vendor access below,
  # so a database driver or web framework leaking into the core is a hard failure —
  # the core's purity is a protected invariant, not a coincidence. Vendors are
  # granted per-adapter via `anyVendorDeps`. Flipping this to true silently disables
  # that lock (the banner flips to "Off | Advanced: vendor imports"); `make arch-check`
  # refuses to pass if it does.
  depOnAnyVendor: false
  # Keep false. deepScan traces DI / data-flow and misattributes the composition
  # root's wiring (cmd builds a concrete adapter and injects it through a port) as a
  # phantom adapter->service edge. We enforce the import graph, not data-flow.
  deepScan: false

# Co-located tests deliberately cross layers: the service test drives the in-memory
# mock repository adapter — correct Clean-Architecture testing, with the test (not
# production code) doing the wiring. Boundaries are enforced on the production import
# graph, not on tests.
excludeFiles:
  - "^.*_test\\.go$"

components:
  # Cross-cutting infrastructure contracts (logger, and the router for HTTP types).
  # Always present — every project ships a logger.
  shared:        { in: internal/core/shared }
{{- if $hasCore}}
  # The `user` aggregate: its own domain / ports / services sub-packages. Grouping
  # by aggregate (not by layer) is what lets a second feature be added as a sibling
  # package instead of swelling flat folders — while arch-lint still enforces the
  # layer direction WITHIN the aggregate (services -> ports -> domain).
  user-domain:   { in: internal/core/user/domain }
  user-ports:    { in: internal/core/user/ports }
  user-services: { in: internal/core/user/services }
  repositories: { in: internal/adapters/repositories/* }
{{- end}}
{{- if eq .ProjectType "worker"}}
  # The `message` aggregate (worker only) — a second bounded context, demonstrating
  # the multi-aggregate layout. Only its domain is generated today.
  message-domain: { in: internal/core/message/domain }
{{- end}}
  loggers:      { in: internal/adapters/loggers/* }
{{- if $hasHandlers}}
  handlers:     { in: internal/adapters/handlers/* }
  cmd-server:   { in: cmd/server }
{{- end}}
{{- if $hasApiResponse}}
  api-response: { in: internal/adapters/api }
{{- end}}
{{- if $hasBrokers}}
  brokers:      { in: internal/adapters/brokers/* }
{{- end}}
{{- if $hasWeb}}
  web:          { in: internal/web }
{{- end}}
  configs:      { in: configs }
  tools:        { in: tools }
  cmd:          { in: cmd }

deps:
  # PURE CORE. No `anyVendorDeps`: the aggregates + shared are stdlib + each other
  # only. Leaves (user-domain, message-domain, shared) depend on nothing, so they
  # are omitted here; the layering within the user aggregate is enforced below.
{{- if $hasCore}}
  user-ports:
    mayDependOn: [user-domain]
  user-services:
    mayDependOn: [user-domain, user-ports]
{{- end}}

  # ADAPTERS — the only place third-party libraries may live.
{{- if $hasCore}}
  repositories:
    mayDependOn: [user-domain, shared]
    anyVendorDeps: true          # database driver (the mock adapter has no vendor)
{{- end}}
  loggers:
    mayDependOn: [shared]
    anyVendorDeps: true          # zap / logrus (log / slog are stdlib)
{{- if $hasHandlers}}
  handlers:
    mayDependOn: [user-domain, user-ports, shared{{if $hasApiResponse}}, api-response{{end}}{{if $hasWeb}}, web{{end}}]
    anyVendorDeps: true          # the chosen HTTP / GraphQL framework
{{- end}}
{{- if $hasApiResponse}}
  api-response:
    mayDependOn: [user-domain]
    anyVendorDeps: true          # HTTP transport types / status helpers
{{- end}}
{{- if $hasBrokers}}
  brokers:
    mayDependOn: [shared]
    anyVendorDeps: true          # kafka / rabbitmq / redis client
{{- end}}
  configs:
    mayDependOn: [tools]
    anyVendorDeps: true          # godotenv
{{- if $hasWeb}}
  # web: embedded HTML/CSS assets (stdlib `embed` only). Depends on nothing — omitted.
{{- end}}
  # tools: stdlib-only leaf. Depends on nothing — omitted.

  # COMPOSITION ROOT — the deliberate escape hatch, exactly one per project: cmd
  # constructs concrete adapters and injects them into services.
  cmd:
    mayDependOn: [shared, loggers, configs, tools{{if $hasCore}}, user-domain, user-ports, user-services, repositories{{end}}{{if eq .ProjectType "worker"}}, message-domain{{end}}{{if $hasHandlers}}, handlers, cmd-server{{end}}{{if $hasApiResponse}}, api-response{{end}}{{if $hasBrokers}}, brokers{{end}}{{if $hasWeb}}, web{{end}}]
    anyVendorDeps: true
{{- if $hasHandlers}}
  cmd-server:
    mayDependOn: [shared, user-domain, user-ports, user-services, repositories, loggers, configs, tools, handlers{{if $hasApiResponse}}, api-response{{end}}{{if $hasBrokers}}, brokers{{end}}{{if $hasWeb}}, web{{end}}]
    anyVendorDeps: true
{{- end}}
