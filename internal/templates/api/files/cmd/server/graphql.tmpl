package server

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

{{- if .Auth}}
	"{{.Name}}/internal/adapters/handlers/auth"
{{- end}}
	"{{.Name}}/internal/adapters/handlers/health"
	"{{.Name}}/internal/adapters/handlers/middleware"
	"{{.Name}}/internal/core/shared"
{{- if .Observability}}
	"{{.Name}}/internal/adapters/observability"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
{{- end}}

	"github.com/graphql-go/graphql"
	"github.com/graphql-go/handler"
)

func Serve(schema graphql.Schema, logger shared.Logger) {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	logger.Info(fmt.Sprintf("The GraphQL server is accessible at http://localhost:%s/graphql", port))

{{- if .Observability}}
	// Initialize OpenTelemetry (OTLP export from the OTEL_* env). The deferred
	// shutdown is registered first so it runs LAST — after the server drains below —
	// flushing buffered spans/metrics. Fail-open: a setup error is logged, not fatal.
	otelShutdown, err := observability.Setup(context.Background())
	if err != nil {
		logger.Error("otel setup failed; continuing without telemetry", "error", err)
	}
	defer func() {
		flushCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = otelShutdown(flushCtx)
	}()
{{- end}}

{{- if .Auth}}
	// Auth config, read here like PORT (no config threaded through main). The
	// JWT_*/AUTH_* values live in .env.
	authSecret := []byte(os.Getenv("JWT_SECRET"))
	authIssuer := os.Getenv("JWT_ISSUER")
	authTTL, err := time.ParseDuration(os.Getenv("JWT_TTL"))
	if err != nil || authTTL <= 0 {
		authTTL = 15 * time.Minute
	}
	authUser := os.Getenv("AUTH_USERNAME")
	authPass := os.Getenv("AUTH_PASSWORD")
{{- end}}

	mux := http.NewServeMux()
	mux.Handle("/graphql", {{if .Observability}}otelhttp.NewHandler({{end}}middleware.Chain(
		handler.New(&handler.Config{
			Schema:     &schema,
			Pretty:     true,
			GraphiQL:   false,
			Playground: true,
		}),
		middleware.Recover(logger),
		middleware.RequestLogger(logger),
		middleware.CORS,
{{- if .Auth}}
		auth.Middleware(authSecret, authIssuer),
{{- end}}
		middleware.Timeout(10*time.Second),
	){{if .Observability}}, "http.server"){{end}})
	mux.HandleFunc("/healthz", health.Live)
	mux.HandleFunc("/readyz", health.Ready)
{{- if .Auth}}
	// Public token issuer on its own chain (CORS/Recover/RequestLogger). GraphQL
	// clients send the token in Authorization; introspection needs a token too.
	mux.Handle("/login", {{if .Observability}}otelhttp.NewHandler({{end}}middleware.Chain(
		auth.LoginHandler(authSecret, authTTL, authIssuer, authUser, authPass),
		middleware.Recover(logger),
		middleware.RequestLogger(logger),
		middleware.CORS,
	){{if .Observability}}, "login"){{end}})
{{- end}}

	server := &http.Server{
		Addr:         fmt.Sprintf(":%s", port),
		Handler:      mux,
		IdleTimeout:  time.Minute,
		ReadTimeout:  10 * time.Second,
		WriteTimeout: 30 * time.Second,
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	go func() {
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			logger.Fatal(err)
		}
	}()

	<-ctx.Done()
	stop()

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := server.Shutdown(shutdownCtx); err != nil {
		logger.Error("graceful shutdown failed", "error", err)
	}
}
