package main

import (
	{{- if .Broker}}
	"context"
	"os"
	"os/signal"
	"syscall"
	{{- end}}
	"{{.Name}}/cmd/server"
	"{{.Name}}/configs"
	{{- if .Broker}}
	"{{.Name}}/internal/adapters/brokers/{{.Broker}}"
	{{- end}}
	"{{.Name}}/internal/adapters/handlers/{{.Platform}}"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/adapters/repositories/{{.Database}}"
	"{{.Name}}/internal/core/user/services"
)

func init() {
	configs.LoadEnv()
}

func main() {
	logger := {{.Logger}}.New()
	db, err := {{.Database}}.New(logger)
	if err != nil {
		logger.Fatal(err)
	}
{{- if .Broker}}
	broker, err := {{.Broker}}.New("testing", logger)
	if err != nil {
		logger.Fatal(err)
	}
	defer func() { _ = broker.Close() }()

	service := services.NewUserService(db).WithPublisher(broker)

	// The consumer runs alongside the HTTP server; bind it to a signal context so
	// Ctrl+C / SIGTERM unblocks Consume and it drains instead of being killed
	// mid-message. The HTTP server manages its own shutdown inside server.Serve.
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	// Consumer side: process events off the broker alongside the HTTP server.
	go func() {
		if err := broker.Consume(ctx, func(value []byte) {
			logger.Info("event received", "payload", string(value))
		}); err != nil && ctx.Err() == nil {
			logger.Error(err.Error())
		}
	}()
{{- else}}
	service := services.NewUserService(db)
{{- end}}
	schema := {{.Platform}}.New(service)
	server.Serve(schema, logger)
}
