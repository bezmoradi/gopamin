# API Environment Variables
PORT=8080
# Origins (scheme://host[:port], comma-separated) whose browser pages may call this
# API. Empty: same-origin only. Never "*": list the front ends you trust.
CORS_ALLOWED_ORIGINS=
{{- if eq .Platform "graphql"}}
# Schema introspection (for GraphQL tooling). Keep false outside local development.
GRAPHQL_INTROSPECTION=false
{{- end}}