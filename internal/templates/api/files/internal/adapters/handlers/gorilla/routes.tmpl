package gorilla

import (
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/ports"
	"net/http"

	"github.com/gorilla/mux"
)

type router struct {
	engine       *mux.Router
	globalPrefix string
	service      ports.UserServiceInterface
}

func NewRouter(service ports.UserServiceInterface) shared.RouterInterface {
	return &router{
		engine:       mux.NewRouter(),
		globalPrefix: "/api/v1",
		service:      service,
	}
}

func (router router) Register() http.Handler {
	router.registerUserRoutes()
	return router.engine
}
