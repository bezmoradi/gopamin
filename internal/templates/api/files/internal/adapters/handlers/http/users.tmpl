package http

import (
	"encoding/json"
	"errors"
	"fmt"
	"net/http"

	"{{.Name}}/internal/adapters/api"
	"{{.Name}}/internal/core/user/domain"
)

func (router router) registerUserRoutes() {
	prefix := router.globalPrefix + "/users"

	router.engine.HandleFunc(fmt.Sprintf("GET %v", prefix), router.IndexHandler)
	router.engine.HandleFunc(fmt.Sprintf("GET %v/{id}", prefix), router.ShowUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("POST %v", prefix), router.CreateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("PUT %v/{id}", prefix), router.UpdateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("DELETE %v/{id}", prefix), router.DeleteUserHandler)
}

func (router router) CreateUserHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")

	var body struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.FailedToReadRequestBody})
		return
	}

	result, err := router.service.Create(r.Context(), body.Name)
	if domain.IsValidationError(err) {
		w.WriteHeader(http.StatusUnprocessableEntity)
		_ = json.NewEncoder(w).Encode(api.Response{Message: err.Error(), Error: api.ValidationFailure})
		return
	}
	if err != nil {
		router.fail(w, "create user", err)
		return
	}

	w.WriteHeader(http.StatusCreated)
	_ = json.NewEncoder(w).Encode(api.Response{Message: "Created user successfully", Data: result})
}

func (router router) DeleteUserHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	id := r.PathValue("id")

	rowsAffected, err := router.service.Delete(r.Context(), id)
	if err != nil {
		router.fail(w, "delete user", err)
		return
	}

	if rowsAffected == 0 {
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.NotFoundError})
		return
	}

	_ = json.NewEncoder(w).Encode(api.Response{Message: fmt.Sprintf("deleted user with ID of %v successfully", id)})
}

func (router router) IndexHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")

	limit, cursor := api.PageParams(r.URL.Query())

	result, err := router.service.Index(r.Context(), limit, cursor)
	if errors.Is(err, domain.ErrInvalidCursor) {
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.InvalidCursor})
		return
	}
	if err != nil {
		router.fail(w, "list users", err)
		return
	}

	_ = json.NewEncoder(w).Encode(api.Response{
		Message:    "Fetched users successfully",
		Data:       api.NewUsers(result.Items),
		NextCursor: result.NextCursor,
	})
}

func (router router) ShowUserHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")

	result, err := router.service.Show(r.Context(), r.PathValue("id"))
	if errors.Is(err, domain.ErrUserNotFound) {
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.NotFoundError})
		return
	}
	if err != nil {
		router.fail(w, "fetch user", err)
		return
	}

	_ = json.NewEncoder(w).Encode(api.Response{Message: "Fetched user successfully", Data: api.NewUser(result)})
}

func (router router) UpdateUserHandler(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")

	var body struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.FailedToReadRequestBody})
		return
	}

	rowsAffected, err := router.service.Update(r.Context(), r.PathValue("id"), body.Name)
	if domain.IsValidationError(err) {
		w.WriteHeader(http.StatusUnprocessableEntity)
		_ = json.NewEncoder(w).Encode(api.Response{Message: err.Error(), Error: api.ValidationFailure})
		return
	}
	if err != nil {
		router.fail(w, "update user", err)
		return
	}
	if rowsAffected == 0 {
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(api.Response{Error: api.NotFoundError})
		return
	}

	_ = json.NewEncoder(w).Encode(api.Response{Message: "User updated successfully", Data: rowsAffected})
}
