package graphql

import (
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"os"

	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/core/user/ports"

	"github.com/graphql-go/graphql"
	"github.com/graphql-go/graphql/gqlerrors"
	"github.com/graphql-go/graphql/language/ast"
	"github.com/graphql-go/graphql/language/parser"
)

// errInternal is what a server-side fault tells the client. The underlying
// error is deliberately never surfaced: it can carry datastore credentials,
// host names, and query text. It is logged instead — see sanitize.
var errInternal = errors.New("internal server error")

// Query limits. Every root field is a datastore call, so without a cap aliases
// (`a: users b: users ...`) turn one small request into hundreds of queries.
const (
	maxRootFields = 10
	maxFields     = 100
)

// NewHandler serves the user schema; cmd/server mounts it at /graphql. Only a POST
// with a JSON body is accepted (middleware.RequireJSON enforces the media type):
// no GET, no form posts and no operation in the URL, so a cross-site link or form
// can't run a mutation. There is no Playground, and introspection is refused
// unless GRAPHQL_INTROSPECTION=true.
func NewHandler(service ports.UserServiceInterface, logger shared.Logger) http.Handler {
	schema := newSchema(service, logger)
	allowIntrospection := os.Getenv("GRAPHQL_INTROSPECTION") == "true"

	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			w.Header().Set("Allow", http.MethodPost)
			writeResult(w, http.StatusMethodNotAllowed, failure("use POST with a JSON body"))
			return
		}
		if r.URL.RawQuery != "" {
			writeResult(w, http.StatusBadRequest, failure("send the operation in the JSON body, not the URL"))
			return
		}

		var req struct {
			Query         string         `json:"query"`
			OperationName string         `json:"operationName"`
			Variables     map[string]any `json:"variables"`
		}
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			if _, ok := errors.AsType[*http.MaxBytesError](err); ok {
				writeResult(w, http.StatusRequestEntityTooLarge, failure("request body too large"))
				return
			}
			writeResult(w, http.StatusBadRequest, failure("malformed JSON body"))
			return
		}

		doc, err := parser.Parse(parser.ParseParams{Source: req.Query})
		if err != nil {
			writeResult(w, http.StatusBadRequest, &graphql.Result{Errors: gqlerrors.FormatErrors(err)})
			return
		}
		if err := checkLimits(doc, allowIntrospection); err != nil {
			writeResult(w, http.StatusBadRequest, failure(err.Error()))
			return
		}
		if v := graphql.ValidateDocument(&schema, doc, nil); !v.IsValid {
			writeResult(w, http.StatusBadRequest, &graphql.Result{Errors: v.Errors})
			return
		}

		writeResult(w, http.StatusOK, graphql.Execute(graphql.ExecuteParams{
			Schema:        schema,
			AST:           doc,
			OperationName: req.OperationName,
			Args:          req.Variables,
			Context:       r.Context(),
		}))
	})
}

func failure(message string) *graphql.Result {
	return &graphql.Result{Errors: []gqlerrors.FormattedError{gqlerrors.NewFormattedError(message)}}
}

func writeResult(w http.ResponseWriter, status int, result *graphql.Result) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(result)
}

// checkLimits rejects a document that selects more than maxFields fields in
// total or more than maxRootFields root fields in an operation, or that
// introspects the schema while introspection is off.
func checkLimits(doc *ast.Document, allowIntrospection bool) error {
	fragments := map[string]*ast.FragmentDefinition{}
	for _, def := range doc.Definitions {
		if f, ok := def.(*ast.FragmentDefinition); ok && f.Name != nil {
			fragments[f.Name.Value] = f
		}
	}

	fields := 0
	var walk func(set *ast.SelectionSet) error
	walk = func(set *ast.SelectionSet) error {
		if set == nil {
			return nil
		}
		for _, sel := range set.Selections {
			switch s := sel.(type) {
			case *ast.Field:
				if fields++; fields > maxFields {
					return fmt.Errorf("query selects more than %d fields", maxFields)
				}
				if !allowIntrospection && s.Name != nil && (s.Name.Value == "__schema" || s.Name.Value == "__type") {
					return errors.New("introspection is disabled")
				}
				if err := walk(s.SelectionSet); err != nil {
					return err
				}
			case *ast.InlineFragment:
				if err := walk(s.SelectionSet); err != nil {
					return err
				}
			}
		}
		return nil
	}

	for _, def := range doc.Definitions {
		switch d := def.(type) {
		case *ast.OperationDefinition:
			if n := rootFields(d.SelectionSet, fragments, map[string]bool{}); n > maxRootFields {
				return fmt.Errorf("operation selects more than %d root fields", maxRootFields)
			}
			if err := walk(d.SelectionSet); err != nil {
				return err
			}
		case *ast.FragmentDefinition:
			if err := walk(d.SelectionSet); err != nil {
				return err
			}
		}
	}
	return nil
}

// rootFields counts the fields an operation selects at the root, following
// inline fragments and fragment spreads (each named fragment once).
func rootFields(set *ast.SelectionSet, fragments map[string]*ast.FragmentDefinition, seen map[string]bool) int {
	if set == nil {
		return 0
	}
	n := 0
	for _, sel := range set.Selections {
		switch s := sel.(type) {
		case *ast.Field:
			n++
		case *ast.InlineFragment:
			n += rootFields(s.SelectionSet, fragments, seen)
		case *ast.FragmentSpread:
			if s.Name != nil && !seen[s.Name.Value] {
				seen[s.Name.Value] = true
				if f := fragments[s.Name.Value]; f != nil {
					n += rootFields(f.SelectionSet, fragments, seen)
				}
			}
		}
	}
	return n
}

func newSchema(service ports.UserServiceInterface, logger shared.Logger) graphql.Schema {
	// sanitize decides what the response's errors array may show: a domain
	// sentinel's text is written by us and safe to echo; anything else — a driver
	// or broker failure — is logged for an operator and collapses to errInternal
	// for the client. It is the same policy the REST handlers apply with status
	// codes, restated for a transport whose failures all travel in-band at HTTP
	// 200. Every resolver returns its errors through here.
	sanitize := func(operation string, err error) error {
		if domain.IsValidationError(err) ||
			errors.Is(err, domain.ErrUserNotFound) ||
			errors.Is(err, domain.ErrInvalidCursor) {
			return err
		}
		logger.Error(operation+" failed", "error", err)
		return errInternal
	}

	userType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "User",
			Fields: graphql.Fields{
				"id": &graphql.Field{
					Type: graphql.String,
				},
				"name": &graphql.Field{
					Type: graphql.String,
				},
			},
		},
	)

	// GraphQL is statically typed, so a paginated list can't reuse the bare
	// [User] type — it needs an explicit page shape carrying the opaque cursor.
	userPageType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "UserPage",
			Fields: graphql.Fields{
				"items": &graphql.Field{
					Type: graphql.NewList(userType),
				},
				"next_cursor": &graphql.Field{
					Type: graphql.String,
				},
			},
		},
	)

	queryType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "Query",
			Fields: graphql.Fields{
				"user": &graphql.Field{
					Type:        userType,
					Description: "Get a user by id",
					Args: graphql.FieldConfigArgument{
						"id": &graphql.ArgumentConfig{
							Type: graphql.String,
						},
					},
					Resolve: func(p graphql.ResolveParams) (any, error) {
						id, ok := p.Args["id"].(string)
						if !ok {
							return nil, errors.New("id argument is required and must be a string")
						}
						// Return nil (not a zero-value User) with the error, so the
						// data field renders as null instead of an empty object.
						user, err := service.Show(p.Context, id)
						if err != nil {
							return nil, sanitize("fetch user", err)
						}
						return user, nil
					},
				},
				"users": &graphql.Field{
					Type:        userPageType,
					Description: "Get a page of users; pass cursor from a previous page to continue",
					Args: graphql.FieldConfigArgument{
						"limit": &graphql.ArgumentConfig{
							Type: graphql.Int,
						},
						"cursor": &graphql.ArgumentConfig{
							Type: graphql.String,
						},
					},
					Resolve: func(params graphql.ResolveParams) (any, error) {
						limit, _ := params.Args["limit"].(int)
						cursor, _ := params.Args["cursor"].(string)

						page, err := service.Index(params.Context, limit, cursor)
						if err != nil {
							return nil, sanitize("list users", err)
						}

						return map[string]any{
							"items":       page.Items,
							"next_cursor": page.NextCursor,
						}, nil
					},
				},
			},
		})

	mutationType := graphql.NewObject(graphql.ObjectConfig{
		Name: "Mutation",
		Fields: graphql.Fields{
			"create": &graphql.Field{
				Type:        graphql.String,
				Description: "Create a new user",
				Args: graphql.FieldConfigArgument{
					"name": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
				},
				Resolve: func(params graphql.ResolveParams) (any, error) {
					name, ok := params.Args["name"].(string)
					if !ok {
						return nil, errors.New("name argument is required and must be a string")
					}
					id, err := service.Create(params.Context, name)
					if err != nil {
						return nil, sanitize("create user", err)
					}
					return id, nil
				},
			},
			"update": &graphql.Field{
				Type:        userType,
				Description: "Update user by ID; returns the updated user",
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
					"name": &graphql.ArgumentConfig{
						Type: graphql.String,
					},
				},
				Resolve: func(params graphql.ResolveParams) (any, error) {
					id, ok := params.Args["id"].(string)
					if !ok {
						return nil, errors.New("id argument is required and must be a string")
					}
					name, _ := params.Args["name"].(string)
					user, err := service.Update(params.Context, id, name)
					if err != nil {
						return nil, sanitize("update user", err)
					}
					return user, nil
				},
			},
			"delete": &graphql.Field{
				Type:        graphql.Boolean,
				Description: "Delete user by ID; returns true",
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
				},
				Resolve: func(params graphql.ResolveParams) (any, error) {
					id, ok := params.Args["id"].(string)
					if !ok {
						return nil, errors.New("id argument is required and must be a string")
					}
					if err := service.Delete(params.Context, id); err != nil {
						return nil, sanitize("delete user", err)
					}
					return true, nil
				},
			},
		},
	})

	schema, err := graphql.NewSchema(
		graphql.SchemaConfig{
			Query:    queryType,
			Mutation: mutationType,
		},
	)
	if err != nil {
		panic(err)
	}

	return schema
}
