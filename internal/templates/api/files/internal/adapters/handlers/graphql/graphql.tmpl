package graphql

import (
	"errors"

	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/core/user/ports"

	"github.com/graphql-go/graphql"
)

// errInternal is what a server-side fault tells the client. The underlying
// error is deliberately never surfaced: it can carry datastore credentials,
// host names, and query text. It is logged instead — see sanitize.
var errInternal = errors.New("internal server error")

func New(service ports.UserServiceInterface, logger shared.Logger) graphql.Schema {
	// sanitize decides what the response's errors array may show: a domain
	// sentinel's text is written by us and safe to echo; anything else — a driver
	// or broker failure — is logged for an operator and collapses to errInternal
	// for the client. It is the same policy the REST handlers apply with status
	// codes, restated for a transport whose failures all travel in-band at HTTP
	// 200. Every resolver returns its errors through here.
	sanitize := func(operation string, err error) error {
		if domain.IsValidationError(err) ||
			errors.Is(err, domain.ErrUserNotFound) ||
			errors.Is(err, domain.ErrInvalidCursor) {
			return err
		}
		logger.Error(operation+" failed", "error", err)
		return errInternal
	}

	userType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "User",
			Fields: graphql.Fields{
				"id": &graphql.Field{
					Type: graphql.String,
				},
				"name": &graphql.Field{
					Type: graphql.String,
				},
			},
		},
	)

	// GraphQL is statically typed, so a paginated list can't reuse the bare
	// [User] type — it needs an explicit page shape carrying the opaque cursor.
	userPageType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "UserPage",
			Fields: graphql.Fields{
				"items": &graphql.Field{
					Type: graphql.NewList(userType),
				},
				"next_cursor": &graphql.Field{
					Type: graphql.String,
				},
			},
		},
	)

	queryType := graphql.NewObject(
		graphql.ObjectConfig{
			Name: "Query",
			Fields: graphql.Fields{
				"user": &graphql.Field{
					Type:        userType,
					Description: "Get a user by id",
					Args: graphql.FieldConfigArgument{
						"id": &graphql.ArgumentConfig{
							Type: graphql.String,
						},
					},
					Resolve: func(p graphql.ResolveParams) (interface{}, error) {
						id, ok := p.Args["id"].(string)
						if !ok {
							return nil, errors.New("id argument is required and must be a string")
						}
						// Return nil (not a zero-value User) with the error, so the
						// data field renders as null instead of an empty object.
						user, err := service.Show(p.Context, id)
						if err != nil {
							return nil, sanitize("fetch user", err)
						}
						return user, nil
					},
				},
				"users": &graphql.Field{
					Type:        userPageType,
					Description: "Get a page of users; pass cursor from a previous page to continue",
					Args: graphql.FieldConfigArgument{
						"limit": &graphql.ArgumentConfig{
							Type: graphql.Int,
						},
						"cursor": &graphql.ArgumentConfig{
							Type: graphql.String,
						},
					},
					Resolve: func(params graphql.ResolveParams) (interface{}, error) {
						limit, _ := params.Args["limit"].(int)
						cursor, _ := params.Args["cursor"].(string)

						page, err := service.Index(params.Context, limit, cursor)
						if err != nil {
							return nil, sanitize("list users", err)
						}

						return map[string]interface{}{
							"items":       page.Items,
							"next_cursor": page.NextCursor,
						}, nil
					},
				},
			},
		})

	mutationType := graphql.NewObject(graphql.ObjectConfig{
		Name: "Mutation",
		Fields: graphql.Fields{
			"create": &graphql.Field{
				Type:        graphql.String,
				Description: "Create a new user",
				Args: graphql.FieldConfigArgument{
					"name": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
				},
				Resolve: func(params graphql.ResolveParams) (interface{}, error) {
					name, ok := params.Args["name"].(string)
					if !ok {
						return nil, errors.New("name argument is required and must be a string")
					}
					id, err := service.Create(params.Context, name)
					if err != nil {
						return nil, sanitize("create user", err)
					}
					return id, nil
				},
			},
			"update": &graphql.Field{
				Type:        graphql.String,
				Description: "Update user by ID",
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
					"name": &graphql.ArgumentConfig{
						Type: graphql.String,
					},
				},
				Resolve: func(params graphql.ResolveParams) (interface{}, error) {
					id, ok := params.Args["id"].(string)
					if !ok {
						return nil, errors.New("id argument is required and must be a string")
					}
					name, _ := params.Args["name"].(string)
					rowsAffected, err := service.Update(params.Context, id, name)
					if err != nil {
						return nil, sanitize("update user", err)
					}
					return rowsAffected, nil
				},
			},
			"delete": &graphql.Field{
				Type:        graphql.String,
				Description: "Delete user by ID",
				Args: graphql.FieldConfigArgument{
					"id": &graphql.ArgumentConfig{
						Type: graphql.NewNonNull(graphql.String),
					},
				},
				Resolve: func(params graphql.ResolveParams) (interface{}, error) {
					id, ok := params.Args["id"].(string)
					if !ok {
						return nil, errors.New("id argument is required and must be a string")
					}
					rowsAffected, err := service.Delete(params.Context, id)
					if err != nil {
						return nil, sanitize("delete user", err)
					}
					return rowsAffected, nil
				},
			},
		},
	})

	schema, err := graphql.NewSchema(
		graphql.SchemaConfig{
			Query:    queryType,
			Mutation: mutationType,
		},
	)
	if err != nil {
		panic(err)
	}

	return schema
}
