package echo

import (
	"encoding/json"
	"errors"
	"fmt"
	"net/http"

	"{{.Name}}/internal/adapters/api"
	"{{.Name}}/internal/core/domain"

	"github.com/labstack/echo/v5"
)

func (router router) registerUserRoutes() {
	group := router.engine.Group(router.globalPrefix + "/users")

	group.GET("", router.IndexHandler)
	group.GET("/:id", router.ShowUserHandler)
	group.POST("", router.CreateUserHandler)
	group.PUT("/:id", router.UpdateUserHandler)
	group.DELETE("/:id", router.DeleteUserHandler)
}

func (router router) CreateUserHandler(c *echo.Context) error {
	var body struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(c.Request().Body).Decode(&body); err != nil {
		return c.JSON(http.StatusBadRequest, api.Response{Error: api.FailedToEncodeBodyPayload})
	}

	result, err := router.service.Create(c.Request().Context(), body.Name)
	if domain.IsValidationError(err) {
		return c.JSON(http.StatusUnprocessableEntity, api.Response{Message: err.Error(), Error: api.RequiredField})
	}
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Response{Error: api.DatabaseOperationFailure})
	}

	return c.JSON(http.StatusCreated, api.Response{Message: "Created user successfully", Data: result})
}

func (router *router) DeleteUserHandler(c *echo.Context) error {
	id := c.Param("id")

	rowsAffected, err := router.service.Delete(c.Request().Context(), id)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Response{Error: api.DatabaseOperationFailure})
	}

	if rowsAffected == 0 {
		return c.JSON(http.StatusNotFound, api.Response{Error: api.NotFoundError})
	}

	return c.JSON(http.StatusOK, api.Response{
		Message: fmt.Sprintf("deleted user with ID of %v successfully", id),
	})
}

func (router *router) IndexHandler(c *echo.Context) error {
	result, err := router.service.Index(c.Request().Context())
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Response{Error: api.DatabaseOperationFailure})
	}

	return c.JSON(http.StatusOK, api.Response{Message: "Fetched users successfully", Data: result})
}

func (router *router) ShowUserHandler(c *echo.Context) error {
	result, err := router.service.Show(c.Request().Context(), c.Param("id"))
	if errors.Is(err, domain.ErrUserNotFound) {
		return c.JSON(http.StatusNotFound, api.Response{Error: api.NotFoundError})
	}
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Response{Error: api.DatabaseOperationFailure})
	}

	return c.JSON(http.StatusOK, api.Response{Message: "Fetched user successfully", Data: result})
}

func (router *router) UpdateUserHandler(c *echo.Context) error {
	var body struct {
		Name string `json:"name"`
	}
	if err := json.NewDecoder(c.Request().Body).Decode(&body); err != nil {
		return c.JSON(http.StatusBadRequest, api.Response{Error: api.FailedToEncodeBodyPayload})
	}

	rowsAffected, err := router.service.Update(c.Request().Context(), c.Param("id"), body.Name)
	if domain.IsValidationError(err) {
		return c.JSON(http.StatusUnprocessableEntity, api.Response{Message: err.Error(), Error: api.RequiredField})
	}
	if err != nil {
		return c.JSON(http.StatusInternalServerError, api.Response{Error: api.DatabaseOperationFailure})
	}
	if rowsAffected == 0 {
		return c.JSON(http.StatusNotFound, api.Response{Error: api.NotFoundError})
	}

	return c.JSON(http.StatusOK, api.Response{Message: "User updated successfully", Data: rowsAffected})
}
