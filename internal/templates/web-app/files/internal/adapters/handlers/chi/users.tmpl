package chi

import (
	"errors"
	"fmt"
	"html/template"
	"io/fs"
	"net/http"
	"strings"

	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/web"

	"github.com/go-chi/chi/v5"
)

func (router router) registerUserRoutes() {
	router.engine.Route(fmt.Sprintf("%v", router.globalPrefix), func(r chi.Router) {
		r.Get("/", router.IndexHandler)
		r.Get("/{id}", router.ShowUserHandler)
		r.Post("/", router.CreateUserHandler)
		r.Put("/{id}", router.UpdateUserHandler)
		r.Delete("/{id}", router.DeleteUserHandler)
	})

	router.serveStaticFiles()
}

func (router router) serveStaticFiles() {
	assetsFS, _ := fs.Sub(web.Assets, "assets")
	path := "/assets"
	if path != "/" && path[len(path)-1] != '/' {
		router.engine.Get(path, http.RedirectHandler(path+"/", http.StatusMovedPermanently).ServeHTTP)
		path += "/"
	}
	path += "*"

	router.engine.Get(path, func(w http.ResponseWriter, r *http.Request) {
		rctx := chi.RouteContext(r.Context())
		pathPrefix := strings.TrimSuffix(rctx.RoutePattern(), "/*")
		handler := http.StripPrefix(pathPrefix, http.FileServer(http.FS(assetsFS)))
		handler.ServeHTTP(w, r)
	})
}

func (router router) CreateUserHandler(w http.ResponseWriter, r *http.Request) {
	err := r.ParseForm()
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	name := r.Form.Get("name")

	_, err = router.service.Create(r.Context(), name)
	if err != nil {
		http.Error(w, err.Error(), http.StatusUnprocessableEntity)
		return
	}
	w.WriteHeader(http.StatusCreated)
}

func (router router) DeleteUserHandler(w http.ResponseWriter, r *http.Request) {
	_, err := router.service.Delete(r.Context(), chi.URLParam(r, "id"))
	if err != nil {
		http.Error(w, err.Error(), http.StatusNotFound)
		return
	}
	w.WriteHeader(http.StatusOK)
}

func (router router) IndexHandler(w http.ResponseWriter, r *http.Request) {
	// Forward-only paging: the "Next" link carries an opaque ?cursor. limit 0
	// lets the service apply its default page size.
	cursor := r.URL.Query().Get("cursor")

	result, err := router.service.Index(r.Context(), 0, cursor)
	if errors.Is(err, domain.ErrInvalidCursor) {
		http.Error(w, "invalid pagination cursor", http.StatusBadRequest)
		return
	}
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	tmpl, err := template.ParseFS(web.Assets, "assets/users.html")
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	err = tmpl.Execute(w, result)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
}

func (router router) ShowUserHandler(w http.ResponseWriter, r *http.Request) {
	result, err := router.service.Show(r.Context(), chi.URLParam(r, "id"))
	if err != nil {
		http.Error(w, err.Error(), http.StatusNotFound)
		return
	}

	tmpl, err := template.ParseFS(web.Assets, "assets/user.html")
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	err = tmpl.Execute(w, result)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
}

func (router router) UpdateUserHandler(w http.ResponseWriter, r *http.Request) {
	err := r.ParseForm()
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}

	name := r.Form.Get("name")

	_, err = router.service.Update(r.Context(), chi.URLParam(r, "id"), name)
	if err != nil {
		http.Error(w, err.Error(), http.StatusNotFound)
		return
	}
	w.WriteHeader(http.StatusOK)
}
