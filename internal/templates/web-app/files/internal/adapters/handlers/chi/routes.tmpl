package chi

import (
	"fmt"
	"io/fs"
	"strings"
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/web"
	"{{.Name}}/internal/core/user/ports"
	"net/http"

	"github.com/go-chi/chi/v5"
)

type router struct {
	engine       *chi.Mux
	globalPrefix string
	service      ports.UserServiceInterface
	logger       shared.Logger
}

func NewRouter(service ports.UserServiceInterface, logger shared.Logger) http.Handler {
	r := &router{
		engine:       chi.NewRouter(),
		globalPrefix: "/users",
		service:      service,
		logger:       logger,
	}
	r.registerUserRoutes()
	return r.engine
}

// fail logs the underlying cause and writes the opaque response the client sees.
// The two live in one place so they cannot drift apart: every internal failure is
// recorded for an operator exactly once, and the client is still told nothing that
// could describe the datastore. Never write a 500 without going through here.
func (router router) fail(w http.ResponseWriter, operation string, err error) {
	router.logger.Error(operation+" failed", "error", err)
	http.Error(w, internalFailure, http.StatusInternalServerError)
}

func (router router) registerUserRoutes() {
	router.engine.Route(fmt.Sprintf("%v", router.globalPrefix), func(r chi.Router) {
		r.Get("/", router.IndexHandler)
		r.Get("/{id}", router.ShowUserHandler)
		r.Post("/", router.CreateUserHandler)
		r.Put("/{id}", router.UpdateUserHandler)
		r.Delete("/{id}", router.DeleteUserHandler)
	})

	router.serveStaticFiles()
}

func (router router) serveStaticFiles() {
	assetsFS, _ := fs.Sub(web.Assets, "assets")
	path := "/assets"
	if path != "/" && path[len(path)-1] != '/' {
		router.engine.Get(path, http.RedirectHandler(path+"/", http.StatusMovedPermanently).ServeHTTP)
		path += "/"
	}
	path += "*"

	router.engine.Get(path, func(w http.ResponseWriter, r *http.Request) {
		rctx := chi.RouteContext(r.Context())
		pathPrefix := strings.TrimSuffix(rctx.RoutePattern(), "/*")
		handler := http.StripPrefix(pathPrefix, http.FileServer(http.FS(assetsFS)))
		handler.ServeHTTP(w, r)
	})
}

// pathID returns the {id} path parameter.
func pathID(r *http.Request) string {
	return chi.URLParam(r, "id")
}
