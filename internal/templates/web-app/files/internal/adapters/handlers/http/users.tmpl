package http

import (
	"errors"
	"fmt"
	"html/template"
	"io/fs"
	"net/http"

	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/web"
)

// internalFailure is what a server-side fault tells the browser. The underlying
// error is deliberately never echoed: it can carry datastore credentials, host
// names, and query text. Log it if you need it; do not render it.
const internalFailure = "internal server error"

func (router router) registerUserRoutes() {
	router.engine.HandleFunc(fmt.Sprintf("GET %v", router.globalPrefix), router.IndexHandler)
	router.engine.HandleFunc(fmt.Sprintf("GET %v/{id}", router.globalPrefix), router.ShowUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("POST %v", router.globalPrefix), router.CreateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("PUT %v/{id}", router.globalPrefix), router.UpdateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("DELETE %v/{id}", router.globalPrefix), router.DeleteUserHandler)

	router.engine.Handle("GET /assets/", router.serveStaticFiles())
}

func (router router) serveStaticFiles() http.Handler {
	assetsFS, _ := fs.Sub(web.Assets, "assets")
	return http.StripPrefix("/assets/", http.FileServer(http.FS(assetsFS)))
}

func (router router) CreateUserHandler(w http.ResponseWriter, r *http.Request) {
	err := r.ParseForm()
	if err != nil {
		http.Error(w, "malformed form body", http.StatusBadRequest)
		return
	}

	name := r.Form.Get("name")

	_, err = router.service.Create(r.Context(), name)
	if domain.IsValidationError(err) {
		// A domain sentinel's own text is written by us and safe to show.
		http.Error(w, err.Error(), http.StatusUnprocessableEntity)
		return
	}
	if err != nil {
		router.fail(w, "create user", err)
		return
	}
	w.WriteHeader(http.StatusCreated)
}

func (router router) DeleteUserHandler(w http.ResponseWriter, r *http.Request) {
	rowsAffected, err := router.service.Delete(r.Context(), r.PathValue("id"))
	if err != nil {
		router.fail(w, "delete user", err)
		return
	}
	if rowsAffected == 0 {
		http.Error(w, "user not found", http.StatusNotFound)
		return
	}
	w.WriteHeader(http.StatusOK)
}

func (router router) IndexHandler(w http.ResponseWriter, r *http.Request) {
	// Forward-only paging: the "Next" link carries an opaque ?cursor. limit 0
	// lets the service apply its default page size.
	cursor := r.URL.Query().Get("cursor")

	result, err := router.service.Index(r.Context(), 0, cursor)
	if errors.Is(err, domain.ErrInvalidCursor) {
		http.Error(w, "invalid pagination cursor", http.StatusBadRequest)
		return
	}
	if err != nil {
		router.fail(w, "list users", err)
		return
	}

	tmpl, err := template.ParseFS(web.Assets, "assets/users.html")
	if err != nil {
		router.fail(w, "load page template", err)
		return
	}

	err = tmpl.Execute(w, result)
	if err != nil {
		router.fail(w, "render page", err)
		return
	}
}

func (router router) ShowUserHandler(w http.ResponseWriter, r *http.Request) {
	result, err := router.service.Show(r.Context(), r.PathValue("id"))
	if errors.Is(err, domain.ErrUserNotFound) {
		http.Error(w, "user not found", http.StatusNotFound)
		return
	}
	if err != nil {
		router.fail(w, "fetch user", err)
		return
	}

	tmpl, err := template.ParseFS(web.Assets, "assets/user.html")
	if err != nil {
		router.fail(w, "load page template", err)
		return
	}

	err = tmpl.Execute(w, result)
	if err != nil {
		router.fail(w, "render page", err)
		return
	}
}

func (router router) UpdateUserHandler(w http.ResponseWriter, r *http.Request) {
	err := r.ParseForm()
	if err != nil {
		http.Error(w, "malformed form body", http.StatusBadRequest)
		return
	}

	name := r.Form.Get("name")

	rowsAffected, err := router.service.Update(r.Context(), r.PathValue("id"), name)
	if domain.IsValidationError(err) {
		http.Error(w, err.Error(), http.StatusUnprocessableEntity)
		return
	}
	if err != nil {
		router.fail(w, "update user", err)
		return
	}
	if rowsAffected == 0 {
		http.Error(w, "user not found", http.StatusNotFound)
		return
	}
	w.WriteHeader(http.StatusOK)
}
