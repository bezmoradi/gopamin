package http

import (
	"fmt"
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/web"
	"{{.Name}}/internal/core/user/ports"
	"net/http"
)

type router struct {
	engine       *http.ServeMux
	globalPrefix string
	service      ports.UserServiceInterface
	logger       shared.Logger
}

func NewRouter(service ports.UserServiceInterface, logger shared.Logger) http.Handler {
	r := &router{
		engine:       http.NewServeMux(),
		globalPrefix: "/users",
		service:      service,
		logger:       logger,
	}
	r.registerUserRoutes()
	return r.engine
}

// fail logs the underlying cause and writes the opaque response the client sees.
// The two live in one place so they cannot drift apart: every internal failure is
// recorded for an operator exactly once, and the client is still told nothing that
// could describe the datastore. Never write a 500 without going through here.
func (router router) fail(w http.ResponseWriter, operation string, err error) {
	router.logger.Error(operation+" failed", "error", err)
	web.RenderError(w, http.StatusInternalServerError, internalFailure)
}

func (router router) registerUserRoutes() {
	router.engine.HandleFunc(fmt.Sprintf("GET %v", router.globalPrefix), router.IndexHandler)
	router.engine.HandleFunc(fmt.Sprintf("GET %v/{id}", router.globalPrefix), router.ShowUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("POST %v", router.globalPrefix), router.CreateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("PUT %v/{id}", router.globalPrefix), router.UpdateUserHandler)
	router.engine.HandleFunc(fmt.Sprintf("DELETE %v/{id}", router.globalPrefix), router.DeleteUserHandler)

	router.engine.Handle("GET /assets/", web.Assets())
}


// pathID returns the {id} path parameter.
func pathID(r *http.Request) string {
	return r.PathValue("id")
}
