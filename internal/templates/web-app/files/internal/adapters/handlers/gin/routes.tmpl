package gin

import (
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/ports"
	"{{.Name}}/internal/web"
	"net/http"
	"os"

	"github.com/gin-gonic/gin"
)

type router struct {
	engine       *gin.Engine
	globalPrefix string
	service      ports.UserServiceInterface
	logger       shared.Logger
}

func NewRouter(service ports.UserServiceInterface, logger shared.Logger) http.Handler {
	// Gin starts in debug mode, which prints its route table and warnings to
	// stdout, past the configured logger. Use release mode unless GIN_MODE is set
	// (GIN_MODE=debug brings that output back).
	if os.Getenv(gin.EnvGinMode) == "" {
		gin.SetMode(gin.ReleaseMode)
	}
	r := &router{
		engine:       gin.New(),
		globalPrefix: "/users",
		service:      service,
		logger:       logger,
	}
	r.registerUserRoutes()
	return r.engine
}

// fail logs the underlying cause and writes the opaque response the client sees.
// The two live in one place so they cannot drift apart: every internal failure is
// recorded for an operator exactly once, and the client is still told nothing that
// could describe the datastore. Never write a 500 without going through here.
func (router *router) fail(c *gin.Context, operation string, err error) {
	router.logger.Error(operation+" failed", "error", err)
	web.RenderError(c.Writer, http.StatusInternalServerError, internalFailure)
}
