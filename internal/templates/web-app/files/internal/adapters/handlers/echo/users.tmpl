package echo

import (
	"errors"
	"net/http"

	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/web"

	"github.com/labstack/echo/v5"
)

// internalFailure is what a server-side fault tells the browser. The underlying
// error is deliberately never echoed: it can carry datastore credentials, host
// names, and query text. Log it if you need it; do not render it.
const internalFailure = "internal server error"

func (router *router) registerUserRoutes() {
	group := router.engine.Group(router.globalPrefix)

	group.GET("", router.IndexHandler)
	group.GET("/:id", router.ShowUserHandler)
	group.POST("", router.CreateUserHandler)
	group.PUT("/:id", router.UpdateUserHandler)
	group.DELETE("/:id", router.DeleteUserHandler)

	router.engine.GET("/assets/*", echo.WrapHandler(web.Assets()))

}

func (router *router) CreateUserHandler(c *echo.Context) error {
	if err := c.Request().ParseForm(); err != nil {
		if _, tooLarge := errors.AsType[*http.MaxBytesError](err); tooLarge {
			return c.String(http.StatusRequestEntityTooLarge, "request body too large")
		}
		return c.String(http.StatusBadRequest, "malformed form body")
	}
	name := c.FormValue("name")
	_, err := router.service.Create(c.Request().Context(), name)
	if domain.IsValidationError(err) {
		// A domain sentinel's own text is written by us and safe to show.
		return c.String(http.StatusUnprocessableEntity, err.Error())
	}
	if err != nil {
		return router.fail(c, "create user", err)
	}
	return c.NoContent(http.StatusCreated)
}

func (router *router) DeleteUserHandler(c *echo.Context) error {
	err := router.service.Delete(c.Request().Context(), c.Param("id"))
	if errors.Is(err, domain.ErrUserNotFound) {
		return c.String(http.StatusNotFound, "user not found")
	}
	if err != nil {
		return router.fail(c, "delete user", err)
	}
	return c.NoContent(http.StatusOK)
}

func (router *router) IndexHandler(c *echo.Context) error {
	// Forward-only paging: the "Next" link carries an opaque ?cursor. limit 0
	// lets the service apply its default page size.
	cursor := c.Request().URL.Query().Get("cursor")

	result, err := router.service.Index(c.Request().Context(), 0, cursor)
	if errors.Is(err, domain.ErrInvalidCursor) {
		return c.String(http.StatusBadRequest, "invalid pagination cursor")
	}
	if err != nil {
		return router.fail(c, "list users", err)
	}

	if err := web.Render(c.Response(), "users.html", result); err != nil {
		return router.fail(c, "render page", err)
	}
	return nil
}

func (router *router) ShowUserHandler(c *echo.Context) error {
	result, err := router.service.Show(c.Request().Context(), c.Param("id"))
	if errors.Is(err, domain.ErrUserNotFound) {
		return c.String(http.StatusNotFound, "user not found")
	}
	if err != nil {
		return router.fail(c, "fetch user", err)
	}

	if err := web.Render(c.Response(), "user.html", result); err != nil {
		return router.fail(c, "render page", err)
	}
	return nil
}

func (router *router) UpdateUserHandler(c *echo.Context) error {
	if err := c.Request().ParseForm(); err != nil {
		if _, tooLarge := errors.AsType[*http.MaxBytesError](err); tooLarge {
			return c.String(http.StatusRequestEntityTooLarge, "request body too large")
		}
		return c.String(http.StatusBadRequest, "malformed form body")
	}
	name := c.FormValue("name")
	_, err := router.service.Update(c.Request().Context(), c.Param("id"), name)
	if domain.IsValidationError(err) {
		return c.String(http.StatusUnprocessableEntity, err.Error())
	}
	if errors.Is(err, domain.ErrUserNotFound) {
		return c.String(http.StatusNotFound, "user not found")
	}
	if err != nil {
		return router.fail(c, "update user", err)
	}
	return c.NoContent(http.StatusOK)
}
