package server

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"os/signal"
{{- if .Observability}}
	"strings"
{{- end}}
	"syscall"
	"time"

	"{{.Name}}/internal/adapters/handlers/health"
	"{{.Name}}/internal/adapters/handlers/middleware"
	"{{.Name}}/internal/core/shared"
{{- if .Observability}}
	"{{.Name}}/internal/adapters/observability"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
{{- end}}
)

func Serve(handlers shared.RouterInterface, logger shared.Logger) {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	logger.Info(fmt.Sprintf("The web server is accessible at http://localhost:%s/users", port))

{{- if .Observability}}
	// Initialize OpenTelemetry (OTLP export from the OTEL_* env). The deferred
	// shutdown is registered first so it runs LAST — after the server drains below —
	// flushing buffered spans/metrics. Fail-open: a setup error is logged, not fatal.
	otelShutdown, err := observability.Setup(context.Background())
	if err != nil {
		logger.Error("otel setup failed; continuing without telemetry", "error", err)
	}
	defer func() {
		flushCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = otelShutdown(flushCtx)
	}()
{{- end}}

	// Mount liveness/readiness at the transport layer so they work regardless of
	// the HTTP framework, then delegate everything else to it.
	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", health.Live)
	mux.HandleFunc("/readyz", health.Ready)
	mux.Handle("/", {{if .Observability}}otelhttp.NewHandler({{end}}middleware.Chain(
		handlers.Register(),
		middleware.Recover(logger),
		middleware.RequestLogger(logger),
		middleware.CORS,
		middleware.Timeout(10*time.Second),
	){{if .Observability}}, "http.server", otelhttp.WithSpanNameFormatter(spanName)){{end}})

	server := &http.Server{
		Addr:         fmt.Sprintf(":%s", port),
		Handler:      mux,
		IdleTimeout:  time.Minute,
		ReadTimeout:  10 * time.Second,
		WriteTimeout: 30 * time.Second,
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	go func() {
		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			logger.Fatal(err)
		}
	}()

	<-ctx.Done()
	stop()

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := server.Shutdown(shutdownCtx); err != nil {
		logger.Error("graceful shutdown failed", "error", err)
	}
}
{{- if .Observability}}

// spanName names each span after its route template. otelhttp otherwise derives
// the name from the mux pattern this handler is mounted on — "/" — so every
// request collapses into one "GET /" span and per-endpoint latency is unreadable.
//
// The route template is used rather than the raw path on purpose: span name is a
// low-cardinality dimension, so a distinct name per user id (or per scanner URL)
// would be a worse problem than the one being fixed. Everything unrouted folds
// into "/". Keep this in step with the routes registered in the handlers package.
func spanName(_ string, r *http.Request) string {
	return r.Method + " " + routeTemplate(r.URL.Path)
}

func routeTemplate(path string) string {
	const users = "/users"

	switch {
	case path == users || path == users+"/":
		return users
	case strings.HasPrefix(path, "/assets/"):
		return "/assets/*"
	case strings.HasPrefix(path, users+"/"):
		return users + "/{id}"
	default:
		return "/"
	}
}
{{- end}}