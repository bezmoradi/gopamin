package main

import (
	"context"
	"fmt"
	"os/signal"
	"syscall"
{{- if .Observability}}
	"time"
{{- end}}

	"{{.Name}}/configs"
	"{{.Name}}/internal/adapters/brokers/{{.Broker}}"
	"{{.Name}}/internal/adapters/events"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
{{- if .Database}}
	"{{.Name}}/internal/adapters/repositories/{{.Database}}"
{{- end}}
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/domain"
{{- if .Database}}
	"{{.Name}}/internal/core/user/services"
{{- end}}
{{- if .Observability}}
	"{{.Name}}/internal/adapters/observability"

	"go.opentelemetry.io/otel"
{{- end}}
)

func init() {
	configs.LoadEnv()
}

func main() {
	logger := {{.Logger}}.New()
	if err := run(logger); err != nil {
		logger.Fatal(err)
	}
}

// run consumes until SIGINT/SIGTERM or a broker failure. It returns instead of
// exiting, so the deferred Close calls run.
func run(logger shared.Logger) error {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
{{- if .Database}}

	repo, err := {{.Database}}.New()
	if err != nil {
		return err
	}
	defer func() { _ = repo.Close() }()
	userService := services.NewUserService(repo)
{{- end}}

	broker, err := {{.Broker}}.New()
	if err != nil {
		return err
	}
	defer func() { _ = broker.Close() }()
{{- if .Observability}}

	// Initialize OpenTelemetry (OTLP export from the OTEL_* env). The deferred flush
	// runs after Consume returns, so in-flight message spans are exported.
	// Fail-open: a setup error is logged, not fatal.
	otelShutdown, err := observability.Setup(context.Background(), logger)
	if err != nil {
		logger.Error("otel setup failed; continuing without telemetry", "error", err)
	}
	defer func() {
		flushCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = otelShutdown(flushCtx)
	}()
	tracer := otel.Tracer("{{.Name}}")
{{- end}}

	// Producer side: publish a sample user.created event, as an upstream service
	// would. The events adapter wraps it in the versioned envelope.
	sample := domain.Event{Kind: domain.UserCreated, User: domain.User{Name: "Hello World"}}
	if err := events.NewPublisher(broker).Publish(ctx, sample); err != nil {
		return fmt.Errorf("publish the sample event: %w", err)
	}

	// Consumer side. Consume blocks until ctx ends (nil) or the broker fails (the
	// error). A handler error means "retry this message"; a message that can never
	// succeed is logged and acknowledged by returning nil.
	logger.Info("worker is running; waiting for messages. Press Ctrl+C to stop.")
	err = broker.Consume(ctx, func({{if or .Database .Observability}}ctx{{else}}_{{end}} context.Context, body []byte) error {
{{- if .Observability}}
		{{if .Database}}ctx{{else}}_{{end}}, span := tracer.Start(ctx, "message.process")
		defer span.End()
{{- end}}
		envelope, err := events.Decode(body)
		if err != nil {
			logger.Error("dropping malformed message", "error", err, "bytes", len(body))
			return nil
		}
{{- if .Database}}
		if envelope.Type != string(domain.UserCreated) {
			logger.Info("event ignored", "type", envelope.Type, "id", envelope.ID)
			return nil
		}

		// CreateOnce keys the user by the event id, so a redelivered event
		// doesn't create a second user.
		err = userService.CreateOnce(ctx, envelope.ID, envelope.Data.Name)
		if domain.IsValidationError(err) {
			logger.Error("dropping invalid event", "id", envelope.ID, "error", err)
			return nil
		}
		if err != nil {
			logger.Error("persisting event failed; will retry", "id", envelope.ID, "error", err)
			return err
		}
		logger.Info("event persisted", "type", envelope.Type, "id", envelope.ID)
{{- else}}
		logger.Info("event received", "type", envelope.Type, "id", envelope.ID, "bytes", len(body))
{{- end}}
		return nil
	})
	logger.Info("worker shutting down")
	return err
}
