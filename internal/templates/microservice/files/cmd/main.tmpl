package main

import (
	"context"
	"os/signal"
	"syscall"

	"{{.Name}}/configs"
	"{{.Name}}/internal/adapters/brokers/{{.Broker}}"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/core/message/domain"
)

func init() {
	configs.LoadEnv()
}

func main() {
	logger := {{.Logger}}.New()

	broker, err := {{.Broker}}.New("testing", logger)
	if err != nil {
		logger.Fatal(err)
	}
	defer func() { _ = broker.Close() }()

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	// Producer side: publish a sample message.
	sample, err := domain.Message{Data: "Hello World"}.ToJson()
	if err != nil {
		logger.Fatal(err)
	}
	if err := broker.Produce(ctx, sample); err != nil {
		logger.Fatal(err)
	}

	// Consumer side: log every message received off the broker.
	go func() {
		consumeErr := broker.Consume(ctx, func(value []byte) {
			logger.Info("message received", "payload", string(value))
		})
		if consumeErr != nil && ctx.Err() == nil {
			logger.Fatal(consumeErr)
		}
	}()

	logger.Info("worker is running; waiting for messages. Press Ctrl+C to stop.")
	<-ctx.Done()
	logger.Info("worker shutting down")
}
