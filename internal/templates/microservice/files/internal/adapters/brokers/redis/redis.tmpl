package redis

import (
	"context"
	"fmt"
	"{{.Name}}/internal/core/ports"
	"os"

	"github.com/redis/go-redis/v9"
)

type redisBroker struct {
	client  *redis.Client
	sub     *redis.PubSub
	channel string
}

func New(channel string, logger ports.Logger) (*redisBroker, error) {
	host := os.Getenv("REDIS_HOST")
	port := os.Getenv("REDIS_PORT")

	client := redis.NewClient(&redis.Options{
		Addr:     fmt.Sprintf("%v:%v", host, port),
		Password: os.Getenv("REDIS_PASSWORD"),
		DB:       0,
	})

	// Subscribe eagerly, at construction, and block until the server confirms the
	// subscription. Redis pub/sub drops any message published while the channel has
	// no subscriber, so a producer that runs before the consumer subscribes would be
	// lost. Confirming the subscription here guarantees it is live before Produce is
	// ever called.
	sub := client.Subscribe(context.Background(), channel)
	if _, err := sub.Receive(context.Background()); err != nil {
		_ = sub.Close()
		_ = client.Close()
		return nil, err
	}

	return &redisBroker{client: client, sub: sub, channel: channel}, nil
}

func (r redisBroker) Close() error {
	_ = r.sub.Close()
	return r.client.Close()
}

func (r redisBroker) Produce(ctx context.Context, value []byte) error {
	return r.client.Publish(ctx, r.channel, value).Err()
}

func (r redisBroker) Consume(ctx context.Context, handler func(value []byte)) error {
	ch := r.sub.Channel()
	for {
		select {
		case <-ctx.Done():
			return nil
		case msg, ok := <-ch:
			if !ok {
				return nil
			}
			handler([]byte(msg.Payload))
		}
	}
}
