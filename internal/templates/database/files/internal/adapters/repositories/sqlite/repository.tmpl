package sqlite

import (
	"context"
	"database/sql"
	"encoding/base64"
	"errors"
	"fmt"
	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/core/shared"
	"os"
	"strconv"

	_ "github.com/mattn/go-sqlite3"
)

const tableName = "users"

type connection struct {
	db *sql.DB
	logger shared.Logger
}

func New(logger shared.Logger) (*connection, error) {
	dburl := os.Getenv("SQLITE_DB_URL")
	if dburl == "" {
		// Fall back to a file in the working directory so the app runs even
		// without a .env (e.g. in a container, where .env is never baked in).
		// Mirrors the badger adapter's hardcoded relative path; under the
		// Dockerfile's WORKDIR this resolves to a writable, volume-mountable path.
		dburl = "./test.db"
	}
	db, err := sql.Open("sqlite3", dburl)
	if err != nil {
		return nil, err
	}

	// Schema is owned by the versioned migrations in migrations/ (run `make
	// migrate-up`), not created here — so the app never races on DDL at startup.
	return &connection{db: db, logger: logger}, nil
}

func (c *connection) Insert(ctx context.Context, name string) (string, error) {
	result, err := c.db.ExecContext(ctx, fmt.Sprintf("INSERT INTO %v (name) VALUES (?)", tableName), name)
	if err != nil {
		return "", err
	}

	lastInsertID, _ := result.LastInsertId()

	return strconv.FormatInt(lastInsertID, 10), nil
}

func (c *connection) Update(ctx context.Context, id string, newName string) (int64, error) {
	// The id column is an integer; a non-numeric id can never match a row.
	if _, err := strconv.Atoi(id); err != nil {
		return 0, nil
	}

	result, err := c.db.ExecContext(
		ctx,
		fmt.Sprintf("UPDATE %v SET name = ? WHERE id = ?", tableName),
		newName,
		id,
	)
	if err != nil {
		return 0, err
	}

	rowsAffected, _ := result.RowsAffected()

	return rowsAffected, nil
}

func (c *connection) Delete(ctx context.Context, id string) (int64, error) {
	// The id column is an integer; a non-numeric id can never match a row.
	if _, err := strconv.Atoi(id); err != nil {
		return 0, nil
	}

	result, err := c.db.ExecContext(
		ctx,
		fmt.Sprintf("DELETE FROM %v WHERE id = ?", tableName),
		id,
	)
	if err != nil {
		return 0, err
	}

	rowsAffected, _ := result.RowsAffected()

	return rowsAffected, nil
}

func (c *connection) Fetch(ctx context.Context, id string) (domain.User, error) {
	// The id column is an integer; a non-numeric id can never match a row.
	if _, err := strconv.Atoi(id); err != nil {
		return domain.User{}, domain.ErrUserNotFound
	}

	var user domain.User
	row := c.db.QueryRowContext(
		ctx,
		fmt.Sprintf(
			"SELECT id, name FROM %s WHERE id = ?",
			tableName,
		),
		id,
	)

	if err := row.Scan(&user.Id, &user.Name); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return domain.User{}, domain.ErrUserNotFound
		}
		return domain.User{}, fmt.Errorf("error fetching data: %w", err)
	}

	return user, nil
}

func (c *connection) FetchAll(ctx context.Context, limit int, cursor string) (domain.Page, error) {
	// Self-defense: the service always clamps limit into [1, max], but a direct
	// caller must not be able to make this method panic on page.Items[limit-1].
	if limit < 1 {
		limit = 1
	}

	// Keyset pagination: the cursor is the last id from the previous page,
	// base64-encoded. Ordering by the integer primary key gives a stable,
	// gap-free walk; id > 0 selects everything for the first (cursor-less) page.
	afterId := 0
	if cursor != "" {
		decoded, err := base64.RawURLEncoding.DecodeString(cursor)
		if err != nil {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		afterId, err = strconv.Atoi(string(decoded))
		if err != nil {
			return domain.Page{}, domain.ErrInvalidCursor
		}
	}

	// Fetch one extra row to learn whether a further page exists.
	rows, err := c.db.QueryContext(
		ctx,
		fmt.Sprintf("SELECT id, name FROM %v WHERE id > ? ORDER BY id ASC LIMIT ?", tableName),
		afterId,
		limit+1,
	)
	if err != nil {
		return domain.Page{}, err
	}
	defer func() { _ = rows.Close() }()

	var users []domain.User
	for rows.Next() {
		var user domain.User
		err := rows.Scan(&user.Id, &user.Name)
		if err != nil {
			return domain.Page{}, err
		}
		users = append(users, user)
	}
	if err := rows.Err(); err != nil {
		return domain.Page{}, err
	}

	page := domain.Page{Items: users}
	if len(users) > limit {
		page.Items = users[:limit]
		page.NextCursor = base64.RawURLEncoding.EncodeToString([]byte(page.Items[limit-1].Id))
	}

	return page, nil
}
