const tableName = "users"

type dynamodbUser struct {
	ID   string `json:"id" dynamodbav:"id"`
	Name string `json:"name" dynamodbav:"firstName"`
}

// connectTimeout bounds startup and the readiness probe, so an unreachable
// endpoint stops the app within seconds instead of on the first request.
const connectTimeout = 5 * time.Second

// tableActiveTimeout bounds the wait for a table New just created: on AWS a new
// table takes a few seconds to become ACTIVE.
const tableActiveTimeout = 2 * time.Minute

// Repository stores users in DynamoDB.
type Repository struct {
	db *dynamodb.Client
}

func mapDynamodbToUser(d dynamodbUser) domain.User {
	return domain.User{
		ID:   d.ID,
		Name: d.Name,
	}
}

// New builds a client and creates the users table if it doesn't exist.
//
// Credentials come from the AWS SDK's default chain (environment, shared
// profile, SSO, or the ECS/EC2/EKS role), unless DYNAMODB_ACCESS_KEY_ID and
// DYNAMODB_SECRET_ACCESS_KEY are both set, as they are for DynamoDB Local.
// DYNAMODB_REGION sets the region (else AWS_REGION), and DYNAMODB_ENDPOINT, when
// set, points the client at DynamoDB Local instead of AWS.
func New() (*Repository, error) {
	var opts []func(*config.LoadOptions) error
	if region := os.Getenv("DYNAMODB_REGION"); region != "" {
		opts = append(opts, config.WithRegion(region))
	}
	accessKeyID := os.Getenv("DYNAMODB_ACCESS_KEY_ID")
	secretAccessKey := os.Getenv("DYNAMODB_SECRET_ACCESS_KEY")
	switch {
	case accessKeyID != "" && secretAccessKey != "":
		opts = append(opts, config.WithCredentialsProvider(
			credentials.NewStaticCredentialsProvider(accessKeyID, secretAccessKey, os.Getenv("DYNAMODB_SESSION_TOKEN")),
		))
	case accessKeyID != "" || secretAccessKey != "":
		return nil, errors.New("set both DYNAMODB_ACCESS_KEY_ID and DYNAMODB_SECRET_ACCESS_KEY, or neither to use the default AWS credential chain")
	}

	ctx, cancel := context.WithTimeout(context.Background(), connectTimeout)
	defer cancel()
	cfg, err := config.LoadDefaultConfig(ctx, opts...)
	if err != nil {
		return nil, err
	}

	endpoint := os.Getenv("DYNAMODB_ENDPOINT")
	r := &Repository{db: dynamodb.NewFromConfig(cfg, func(o *dynamodb.Options) {
		if endpoint != "" {
			o.BaseEndpoint = aws.String(endpoint)
		}
	})}
	if err := r.ensureTable(ctx); err != nil {
		return nil, fmt.Errorf("cannot reach DynamoDB: %w", err)
	}

	return r, nil
}

// Ping reports whether DynamoDB answers and the table exists; /readyz calls it.
func (r *Repository) Ping(ctx context.Context) error {
	_, err := r.db.DescribeTable(ctx, &dynamodb.DescribeTableInput{TableName: aws.String(tableName)})
	return err
}

// Close is a no-op: the client holds no connection that needs releasing. It
// exists so every repository closes the same way.
func (r *Repository) Close() error {
	return nil
}

// ensureTable creates the users table if DescribeTable says it doesn't exist,
// then waits until it is ACTIVE.
func (r *Repository) ensureTable(ctx context.Context) error {
	err := r.Ping(ctx)
	if err == nil {
		return nil
	}
	if _, notFound := errors.AsType[*types.ResourceNotFoundException](err); !notFound {
		return err
	}

	_, err = r.db.CreateTable(ctx, &dynamodb.CreateTableInput{
		AttributeDefinitions: []types.AttributeDefinition{
			{
				AttributeName: aws.String("id"),
				AttributeType: types.ScalarAttributeTypeS,
			},
		},
		KeySchema: []types.KeySchemaElement{
			{
				AttributeName: aws.String("id"),
				KeyType:       types.KeyTypeHash,
			},
		},
		TableName:   aws.String(tableName),
		BillingMode: types.BillingModePayPerRequest,
	})
	if err != nil {
		return err
	}

	return dynamodb.NewTableExistsWaiter(r.db).Wait(
		context.Background(),
		&dynamodb.DescribeTableInput{TableName: aws.String(tableName)},
		tableActiveTimeout,
	)
}

// validID reports whether id could be a key: Insert issues UUIDs, and anything
// else (including an id past DynamoDB's key size limit) can't match an item, so
// it is a miss rather than a ValidationException.
func validID(id string) bool {
	_, err := uuid.Parse(id)
	return err == nil
}

func (r *Repository) Insert(ctx context.Context, name string) (string, error) {
	id := uuid.New()

	item := map[string]types.AttributeValue{
		"id":        &types.AttributeValueMemberS{Value: id.String()},
		"firstName": &types.AttributeValueMemberS{Value: name},
	}
	_, err := r.db.PutItem(ctx, &dynamodb.PutItemInput{
		TableName:           aws.String(tableName),
		Item:                item,
		ConditionExpression: aws.String("attribute_not_exists(id)"),
		ReturnValues:        "ALL_OLD",
	})
	if err != nil {
		return "", err
	}

	return id.String(), nil
}

{{if eq .ProjectType "worker"}}// InsertOnce inserts a user whose id is key (a consumed event's id, a UUID)
// unless that item already exists.
func (r *Repository) InsertOnce(ctx context.Context, key string, name string) error {
	if !validID(key) {
		return fmt.Errorf("event id %q is not a UUID", key)
	}

	_, err := r.db.PutItem(ctx, &dynamodb.PutItemInput{
		TableName: aws.String(tableName),
		Item: map[string]types.AttributeValue{
			"id":        &types.AttributeValueMemberS{Value: key},
			"firstName": &types.AttributeValueMemberS{Value: name},
		},
		ConditionExpression: aws.String("attribute_not_exists(id)"),
	})
	if _, exists := errors.AsType[*types.ConditionalCheckFailedException](err); exists {
		return nil
	}
	return err
}

{{end}}func (r *Repository) Update(ctx context.Context, id, updatedName string) error {
	if !validID(id) {
		return domain.ErrUserNotFound
	}

	updateExpression := "SET firstName = :updatedName"
	expressionAttributeValues := map[string]types.AttributeValue{
		":updatedName": &types.AttributeValueMemberS{Value: updatedName},
	}

	input := &dynamodb.UpdateItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
		UpdateExpression:          aws.String(updateExpression),
		ExpressionAttributeValues: expressionAttributeValues,
		ConditionExpression:       aws.String("attribute_exists(id)"),
		ReturnValues:              "ALL_NEW",
	}

	_, err := r.db.UpdateItem(ctx, input)
	if err != nil {
		// The conditional check failing means the item does not exist.
		if _, ok := errors.AsType[*types.ConditionalCheckFailedException](err); ok {
			return domain.ErrUserNotFound
		}
		return err
	}

	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	if !validID(id) {
		return domain.ErrUserNotFound
	}

	input := &dynamodb.DeleteItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
		ReturnValues: "ALL_OLD",
	}

	result, err := r.db.DeleteItem(ctx, input)
	if err != nil {
		return err
	}

	if len(result.Attributes) == 0 {
		// Nothing was deleted because the item did not exist.
		return domain.ErrUserNotFound
	}

	return nil
}

func (r *Repository) Fetch(ctx context.Context, id string) (domain.User, error) {
	if !validID(id) {
		return domain.User{}, domain.ErrUserNotFound
	}

	input := &dynamodb.GetItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
	}

	result, err := r.db.GetItem(ctx, input)
	if err != nil {
		return domain.User{}, err
	}

	if len(result.Item) == 0 {
		return domain.User{}, domain.ErrUserNotFound
	}

	var user dynamodbUser
	err = attributevalue.UnmarshalMap(result.Item, &user)
	if err != nil {
		return domain.User{}, err
	}

	return mapDynamodbToUser(user), nil
}

func (r *Repository) FetchAll(ctx context.Context, limit int, cursor string) (domain.Page, error) {
	// Self-defense: the service always clamps limit into [1, max]. Guard anyway —
	// DynamoDB rejects a Scan Limit of 0, so a direct caller passing <= 0 would
	// get a validation error instead of a page.
	if limit < 1 {
		limit = 1
	}

	input := &dynamodb.ScanInput{
		TableName: aws.String(tableName),
		Limit:     aws.Int32(int32(limit)),
	}
	if cursor != "" {
		// The cursor is the base64 id of the last item on the previous page. An
		// id we could never have issued is a forged token: 400, not a Scan the
		// service rejects with a ValidationException (500).
		decoded, err := base64.RawURLEncoding.DecodeString(cursor)
		if err != nil || !validID(string(decoded)) {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		input.ExclusiveStartKey = map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: string(decoded)},
		}
	}

	out, err := r.db.Scan(ctx, input)
	if err != nil {
		return domain.Page{}, err
	}

	var users []domain.User
	for _, item := range out.Items {
		var user dynamodbUser
		if err := attributevalue.UnmarshalMap(item, &user); err != nil {
			return domain.Page{}, err
		}
		users = append(users, mapDynamodbToUser(user))
	}

	// DynamoDB pages via LastEvaluatedKey, not an offset. A non-empty key means
	// more rows remain. Note: Scan has no defined order, so this paginates a
	// complete traversal rather than a sorted sequence.
	page := domain.Page{Items: users}
	if last, ok := out.LastEvaluatedKey["id"].(*types.AttributeValueMemberS); ok {
		page.NextCursor = base64.RawURLEncoding.EncodeToString([]byte(last.Value))
	}

	return page, nil
}
