package dynamodb

import (
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/core/shared"
	"os"
	"strconv"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/config"
	"github.com/aws/aws-sdk-go-v2/credentials"
	"github.com/aws/aws-sdk-go-v2/feature/dynamodb/attributevalue"
	"github.com/aws/aws-sdk-go-v2/service/dynamodb"
	"github.com/aws/aws-sdk-go-v2/service/dynamodb/types"
	"github.com/google/uuid"
)

const tableName = "users"

type dynamodbUser struct {
	ID   string `json:"id" dynamodbav:"id"`
	Name string `json:"name" dynamodbav:"firstName"`
}

type connection struct {
	db *dynamodb.Client
	logger shared.Logger
}

func mapDynamodbToUser(d dynamodbUser) domain.User {
	return domain.User{
		Id:   d.ID,
		Name: d.Name,
	}
}

func New(logger shared.Logger) (*connection, error) {
	databaseAccessKeyID := os.Getenv("DYNAMODB_ACCESS_KEY_ID")
	databaseSecretAccessKey := os.Getenv("DYNAMODB_SECRET_ACCESS_KEY")
	databaseSessionToken := os.Getenv("DYNAMODB_SESSION_TOKEN")
	databaseHost := os.Getenv("DYNAMODB_HOST")
	databaseRegion := os.Getenv("DYNAMODB_REGION")
	databasePort, err := strconv.Atoi(os.Getenv("DYNAMODB_PORT"))
	if err != nil {
		return nil, err
	}

	cfg, err := config.LoadDefaultConfig(context.TODO(),
		config.WithRegion(databaseRegion),
		config.WithCredentialsProvider(credentials.StaticCredentialsProvider{
			Value: aws.Credentials{
				AccessKeyID: databaseAccessKeyID, SecretAccessKey: databaseSecretAccessKey, SessionToken: databaseSessionToken,
			},
		}),
	)
	if err != nil {
		return nil, err
	}

	c := &connection{db: dynamodb.NewFromConfig(cfg, func(o *dynamodb.Options) {
		o.BaseEndpoint = aws.String(fmt.Sprintf("%v:%d", databaseHost, databasePort))
	}), logger: logger}
	if err := c.CreateTable(); err != nil {
		return nil, err
	}

	return c, nil
}

func (c *connection) CreateTable() error {
	tables, err := c.db.ListTables(context.TODO(), &dynamodb.ListTablesInput{})
	if err != nil {
		return err
	}
	for _, n := range tables.TableNames {
		if n == tableName {
			return nil
		}
	}

	_, err = c.db.CreateTable(context.TODO(), &dynamodb.CreateTableInput{
		AttributeDefinitions: []types.AttributeDefinition{
			{
				AttributeName: aws.String("id"),
				AttributeType: types.ScalarAttributeTypeS,
			},
		},
		KeySchema: []types.KeySchemaElement{
			{
				AttributeName: aws.String("id"),
				KeyType:       types.KeyTypeHash,
			},
		},
		TableName:   aws.String(tableName),
		BillingMode: types.BillingModePayPerRequest,
	})
	if err != nil {
		return err
	}

	return nil
}

func (c *connection) Insert(ctx context.Context, name string) (string, error) {
	id := uuid.New()

	item := map[string]types.AttributeValue{
		"id":        &types.AttributeValueMemberS{Value: id.String()},
		"firstName": &types.AttributeValueMemberS{Value: name},
	}
	_, err := c.db.PutItem(ctx, &dynamodb.PutItemInput{
		TableName:           aws.String(tableName),
		Item:                item,
		ConditionExpression: aws.String("attribute_not_exists(id)"),
		ReturnValues:        "ALL_OLD",
	})
	if err != nil {
		return "", err
	}

	return id.String(), nil
}

func (c *connection) Update(ctx context.Context, id, updatedName string) (int64, error) {
	updateExpression := "SET firstName = :updatedName"
	expressionAttributeValues := map[string]types.AttributeValue{
		":updatedName": &types.AttributeValueMemberS{Value: updatedName},
	}

	input := &dynamodb.UpdateItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
		UpdateExpression:          aws.String(updateExpression),
		ExpressionAttributeValues: expressionAttributeValues,
		ConditionExpression:       aws.String("attribute_exists(id)"),
		ReturnValues:              "ALL_NEW",
	}

	_, err := c.db.UpdateItem(ctx, input)
	if err != nil {
		// The conditional check failing means the item does not exist; that is a
		// no-op (0 rows affected), not a server error.
		var conditionFailed *types.ConditionalCheckFailedException
		if errors.As(err, &conditionFailed) {
			return 0, nil
		}
		return 0, err
	}

	return 1, nil
}

func (c *connection) Delete(ctx context.Context, id string) (int64, error) {
	input := &dynamodb.DeleteItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
		ReturnValues: "ALL_OLD",
	}

	result, err := c.db.DeleteItem(ctx, input)
	if err != nil {
		return 0, err
	}

	if len(result.Attributes) == 0 {
		// Nothing was deleted because the item did not exist.
		return 0, nil
	}

	return 1, nil
}

func (c *connection) Fetch(ctx context.Context, id string) (domain.User, error) {
	input := &dynamodb.GetItemInput{
		TableName: aws.String(tableName),
		Key: map[string]types.AttributeValue{
			"id": &types.AttributeValueMemberS{Value: id},
		},
	}

	result, err := c.db.GetItem(ctx, input)
	if err != nil {
		return domain.User{}, err
	}

	if len(result.Item) == 0 {
		return domain.User{}, domain.ErrUserNotFound
	}

	var user dynamodbUser
	err = attributevalue.UnmarshalMap(result.Item, &user)
	if err != nil {
		return domain.User{}, err
	}

	return mapDynamodbToUser(user), nil
}

func (c *connection) FetchAll(ctx context.Context, limit int, cursor string) (domain.Page, error) {
	// Self-defense: the service always clamps limit into [1, max]. Guard anyway —
	// DynamoDB rejects a Scan Limit of 0, so a direct caller passing <= 0 would
	// get a validation error instead of a page.
	if limit < 1 {
		limit = 1
	}

	input := &dynamodb.ScanInput{
		TableName: aws.String(tableName),
		Limit:     aws.Int32(int32(limit)),
	}
	if cursor != "" {
		startKey, err := decodeDynamoCursor(cursor)
		if err != nil {
			return domain.Page{}, err
		}
		input.ExclusiveStartKey = startKey
	}

	out, err := c.db.Scan(ctx, input)
	if err != nil {
		return domain.Page{}, err
	}

	var users []domain.User
	for _, item := range out.Items {
		var user dynamodbUser
		if err := attributevalue.UnmarshalMap(item, &user); err != nil {
			return domain.Page{}, err
		}
		users = append(users, mapDynamodbToUser(user))
	}

	// DynamoDB pages via LastEvaluatedKey, not an offset. A non-empty key means
	// more rows remain. Note: Scan has no defined order, so this paginates a
	// complete traversal rather than a sorted sequence.
	page := domain.Page{Items: users}
	if len(out.LastEvaluatedKey) > 0 {
		next, err := encodeDynamoCursor(out.LastEvaluatedKey)
		if err != nil {
			return domain.Page{}, err
		}
		page.NextCursor = next
	}

	return page, nil
}

// encodeDynamoCursor serialises a LastEvaluatedKey into an opaque token. The key
// is a map[string]types.AttributeValue whose members are a sealed interface, so
// it can't be JSON-marshalled directly — we unmarshal it into a plain map first,
// then base64 the JSON.
func encodeDynamoCursor(key map[string]types.AttributeValue) (string, error) {
	var plain map[string]any
	if err := attributevalue.UnmarshalMap(key, &plain); err != nil {
		return "", err
	}
	raw, err := json.Marshal(plain)
	if err != nil {
		return "", err
	}
	return base64.RawURLEncoding.EncodeToString(raw), nil
}

// decodeDynamoCursor reverses encodeDynamoCursor, rebuilding the attribute map
// used as ExclusiveStartKey. A malformed token is a client error.
func decodeDynamoCursor(cursor string) (map[string]types.AttributeValue, error) {
	raw, err := base64.RawURLEncoding.DecodeString(cursor)
	if err != nil {
		return nil, domain.ErrInvalidCursor
	}
	var plain map[string]any
	if err := json.Unmarshal(raw, &plain); err != nil {
		return nil, domain.ErrInvalidCursor
	}
	key, err := attributevalue.MarshalMap(plain)
	if err != nil {
		return nil, domain.ErrInvalidCursor
	}
	return key, nil
}
