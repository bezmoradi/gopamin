package mongodb

import (
	"context"
	"errors"
	"fmt"
	"{{.Name}}/internal/core/domain"
	"{{.Name}}/internal/core/ports"
	"os"

	"go.mongodb.org/mongo-driver/v2/bson"
	"go.mongodb.org/mongo-driver/v2/mongo"
	"go.mongodb.org/mongo-driver/v2/mongo/options"
)

const collectionName = "users"

type mongodbUser struct {
	Id   bson.ObjectID `json:"id" bson:"_id"`
	Name string             `json:"name" bson:"name"`
}

type connection struct {
	db *mongo.Client
	logger ports.Logger
}

func mapMongodbToUser(m mongodbUser) domain.User {
	return domain.User{
		Id:   m.Id.Hex(),
		Name: m.Name,
	}
}

func New(logger ports.Logger) (*connection, error) {
	host := os.Getenv("MONGODB_HOST")
	port := os.Getenv("MONGODB_PORT")
	username := os.Getenv("MONGODB_USERNAME")
	password := os.Getenv("MONGODB_PASSWORD")

	mongoClient, err := mongo.Connect(options.Client().ApplyURI(fmt.Sprintf("mongodb://%s:%s@%s:%s", username, password, host, port)))
	if err != nil {
		return nil, fmt.Errorf("cannot connect to MongoDB: %w", err)
	}

	if err := mongoClient.Ping(context.Background(), nil); err != nil {
		return nil, fmt.Errorf("cannot reach MongoDB: %w", err)
	}

	c := &connection{db: mongoClient, logger: logger}

	return c, nil
}

func (c *connection) GetCollection() *mongo.Collection {
	database := os.Getenv("MONGODB_NAME")

	return c.db.Database(database).Collection(collectionName)
}

func (c *connection) Insert(ctx context.Context, name string) (string, error) {
	result, err := c.GetCollection().InsertOne(
		ctx,
		bson.M{
			"name": name,
		},
	)
	if err != nil {
		return "", err
	}

	insertedId, ok := result.InsertedID.(bson.ObjectID)
	if !ok {
		return "", fmt.Errorf("unexpected type for InsertedID")
	}

	return insertedId.Hex(), nil
}

func (c *connection) Update(ctx context.Context, id string, name string) (int64, error) {
	objectID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		// A malformed id can never match a document.
		return 0, nil
	}

	result, err := c.GetCollection().UpdateOne(
		ctx,
		bson.D{
			{Key: "_id", Value: objectID},
		}, bson.D{
			{
				Key: "$set",
				Value: bson.D{
					{Key: "name", Value: name},
				},
			},
		},
	)
	if err != nil {
		return 0, err
	}

	return result.ModifiedCount, nil
}

func (c *connection) Delete(ctx context.Context, id string) (int64, error) {
	objectID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		// A malformed id can never match a document.
		return 0, nil
	}

	result, err := c.GetCollection().DeleteOne(ctx, bson.D{
		{Key: "_id", Value: objectID},
	})
	if err != nil {
		return 0, err
	}

	return result.DeletedCount, nil
}

func (c *connection) Fetch(ctx context.Context, id string) (domain.User, error) {
	objectID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		// A malformed id can never match a document.
		return domain.User{}, domain.ErrUserNotFound
	}

	var user mongodbUser
	filter := bson.D{
		{Key: "_id", Value: objectID},
	}

	err = c.GetCollection().FindOne(ctx, filter).Decode(&user)
	if err != nil {
		if errors.Is(err, mongo.ErrNoDocuments) {
			return domain.User{}, domain.ErrUserNotFound
		}
		return domain.User{}, err
	}

	return mapMongodbToUser(user), nil
}

func (c *connection) FetchAll(ctx context.Context) ([]domain.User, error) {
	var users []domain.User
	cursor, err := c.GetCollection().Find(ctx, bson.D{})
	if err != nil {
		return nil, err
	}
	defer func() { _ = cursor.Close(ctx) }()

	for cursor.Next(ctx) {
		var user mongodbUser
		if err := cursor.Decode(&user); err != nil {
			return nil, err
		}
		users = append(users, mapMongodbToUser(user))
	}

	if err := cursor.Err(); err != nil {
		return nil, err
	}

	return users, nil
}
