package cassandra

import (
	"context"
	"encoding/base64"
	"errors"
	"fmt"
	"{{.Name}}/internal/core/user/domain"
	"{{.Name}}/internal/core/shared"
	"os"
	"strconv"

	"github.com/apache/cassandra-gocql-driver/v2"
)

const tableName = "users"
const keyspace = "test_keyspace"

type connection struct {
	session *gocql.Session
	logger  shared.Logger
}

func New(logger shared.Logger) (*connection, error) {
	databaseHost := os.Getenv("CASSANDRA_HOST")
	databasePort, err := strconv.Atoi(os.Getenv("CASSANDRA_PORT"))
	if err != nil {
		return nil, err
	}

	// Connect without a keyspace first so the keyspace can be created if it does
	// not yet exist (a fresh Cassandra has none, which would otherwise make the
	// app fail to start).
	bootstrap := gocql.NewCluster(databaseHost)
	bootstrap.Port = databasePort
	bootstrapSession, err := bootstrap.CreateSession()
	if err != nil {
		return nil, err
	}
	if err := bootstrapSession.Query(
		fmt.Sprintf(
			"CREATE KEYSPACE IF NOT EXISTS %v WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1}",
			keyspace,
		),
	).Exec(); err != nil {
		bootstrapSession.Close()
		return nil, err
	}
	bootstrapSession.Close()

	cluster := gocql.NewCluster(databaseHost)
	cluster.Port = databasePort
	cluster.Keyspace = keyspace

	session, err := cluster.CreateSession()
	if err != nil {
		return nil, err
	}

	c := &connection{session: session, logger: logger}
	err = c.CreateTable()
	if err != nil {
		return nil, err
	}

	return c, nil
}

func (c *connection) CreateTable() error {
	err := c.session.Query(
		fmt.Sprintf(
			"CREATE TABLE IF NOT EXISTS %v (id UUID PRIMARY KEY, name TEXT)",
			tableName,
		),
	).Exec()

	if err != nil {
		return err
	}

	return nil
}

func (c *connection) Insert(ctx context.Context, name string) (string, error) {
	id := gocql.TimeUUID()
	err := c.session.Query(
		fmt.Sprintf(
			"INSERT INTO %v (id, name) VALUES (?, ?)",
			tableName,
		),
		id,
		name,
	).ExecContext(ctx)

	if err != nil {
		return "", err
	}

	return id.String(), nil
}

func (c *connection) Update(ctx context.Context, id string, newName string) (int64, error) {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return 0, nil
	}

	err := c.session.Query(
		fmt.Sprintf(
			"UPDATE %v SET name = ? WHERE id = ?",
			tableName,
		),
		newName,
		id,
	).ExecContext(ctx)

	if err != nil {
		return 0, err
	}

	return 1, nil
}

func (c *connection) Delete(ctx context.Context, id string) (int64, error) {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return 0, nil
	}

	err := c.session.Query(
		fmt.Sprintf(
			"DELETE FROM %v WHERE id = ?",
			tableName,
		),
		id,
	).ExecContext(ctx)

	if err != nil {
		return 0, err
	}

	return 1, nil
}

func (c *connection) Fetch(ctx context.Context, id string) (domain.User, error) {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return domain.User{}, domain.ErrUserNotFound
	}

	var user domain.User
	err := c.session.Query(
		fmt.Sprintf("SELECT id, name FROM %v WHERE id = ?", tableName),
		id,
	).Consistency(gocql.One).ScanContext(ctx, &user.Id, &user.Name)

	if err != nil {
		if errors.Is(err, gocql.ErrNotFound) {
			return domain.User{}, domain.ErrUserNotFound
		}
		return domain.User{}, fmt.Errorf("error fetching data: %w", err)
	}

	return user, nil
}

func (c *connection) FetchAll(ctx context.Context, limit int, cursor string) (domain.Page, error) {
	// Self-defense: the service always clamps limit into [1, max]. Guard anyway —
	// gocql's PageSize(n) *disables* paging when n <= 0, which would reintroduce
	// the unbounded scan this feature exists to prevent.
	if limit < 1 {
		limit = 1
	}

	// Apache Cassandra has no OFFSET (CASSANDRA-6511, Won't Fix); it pages
	// natively via an opaque driver "paging state". The cursor is that state,
	// base64-encoded. We therefore drop the auto-paging Scanner() and drive the
	// iterator a single page at a time with PageSize + PageState.
	var pageState []byte
	if cursor != "" {
		decoded, err := base64.RawURLEncoding.DecodeString(cursor)
		if err != nil {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		pageState = decoded
	}

	iter := c.session.Query(
		fmt.Sprintf(
			"SELECT id, name FROM %s",
			tableName,
		),
	).PageSize(limit).PageState(pageState).IterContext(ctx)

	var users []domain.User
	var user domain.User
	for iter.Scan(&user.Id, &user.Name) {
		users = append(users, user)
	}

	// PageState() must be read before Close(); an empty state means no more rows.
	nextPageState := iter.PageState()
	if err := iter.Close(); err != nil {
		// A paging state is opaque driver bytes, so unlike the keyset stores it
		// cannot be validated up front: Cassandra only rejects a forged one at
		// execution, as a protocol violation by the client message (0x000A).
		// That is a client error, not a server fault. Scope the mapping to a
		// supplied cursor so a genuine protocol fault still surfaces as 500.
		var reqErr gocql.RequestError
		if cursor != "" && errors.As(err, &reqErr) && reqErr.Code() == gocql.ErrCodeProtocol {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		return domain.Page{}, err
	}

	page := domain.Page{Items: users}
	if len(nextPageState) > 0 {
		page.NextCursor = base64.RawURLEncoding.EncodeToString(nextPageState)
	}

	return page, nil
}
