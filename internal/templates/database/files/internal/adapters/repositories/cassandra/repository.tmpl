package cassandra

import (
	"context"
	"encoding/base64"
	"errors"
	"fmt"
	"os"
	"strconv"

	"{{.Name}}/internal/core/user/domain"

	"github.com/apache/cassandra-gocql-driver/v2"
)

const tableName = "users"
const keyspace = "test_keyspace"

// Repository stores users in Cassandra.
type Repository struct {
	session *gocql.Session
}

// New connects to CASSANDRA_HOST:CASSANDRA_PORT, creating the keyspace and the
// table if they don't exist. The keyspace it creates uses SimpleStrategy with
// replication factor 1, which suits one local node only: on a real cluster,
// create the keyspace yourself first (NetworkTopologyStrategy, RF 3), and New
// leaves it as it is.
func New() (*Repository, error) {
	databaseHost := os.Getenv("CASSANDRA_HOST")
	databasePort, err := strconv.Atoi(os.Getenv("CASSANDRA_PORT"))
	if err != nil {
		return nil, err
	}

	// Connect without a keyspace first so the keyspace can be created if it does
	// not yet exist (a fresh Cassandra has none, which would otherwise make the
	// app fail to start).
	bootstrap := gocql.NewCluster(databaseHost)
	bootstrap.Port = databasePort
	bootstrapSession, err := bootstrap.CreateSession()
	if err != nil {
		return nil, err
	}
	if err := bootstrapSession.Query(
		fmt.Sprintf(
			"CREATE KEYSPACE IF NOT EXISTS %v WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1}",
			keyspace,
		),
	).Exec(); err != nil {
		bootstrapSession.Close()
		return nil, err
	}
	bootstrapSession.Close()

	cluster := gocql.NewCluster(databaseHost)
	cluster.Port = databasePort
	cluster.Keyspace = keyspace

	session, err := cluster.CreateSession()
	if err != nil {
		return nil, err
	}

	r := &Repository{session: session}
	if err := r.createTable(); err != nil {
		session.Close()
		return nil, err
	}

	return r, nil
}

// Ping reports whether a Cassandra node answers; /readyz calls it.
func (r *Repository) Ping(ctx context.Context) error {
	return r.session.Query("SELECT release_version FROM system.local").ExecContext(ctx)
}

// Close closes the session.
func (r *Repository) Close() error {
	r.session.Close()
	return nil
}

func (r *Repository) createTable() error {
	err := r.session.Query(
		fmt.Sprintf(
			"CREATE TABLE IF NOT EXISTS %v (id UUID PRIMARY KEY, name TEXT)",
			tableName,
		),
	).Exec()

	if err != nil {
		return err
	}

	return nil
}

func (r *Repository) Insert(ctx context.Context, name string) (string, error) {
	id := gocql.TimeUUID()
	err := r.session.Query(
		fmt.Sprintf(
			"INSERT INTO %v (id, name) VALUES (?, ?)",
			tableName,
		),
		id,
		name,
	).ExecContext(ctx)

	if err != nil {
		return "", err
	}

	return id.String(), nil
}

{{if eq .ProjectType "worker"}}// InsertOnce inserts a user whose id is key (a consumed event's id, a UUID)
// unless that row already exists. IF NOT EXISTS makes it a lightweight
// transaction, so a redelivered event can't overwrite or duplicate the row.
func (r *Repository) InsertOnce(ctx context.Context, key string, name string) error {
	id, err := gocql.ParseUUID(key)
	if err != nil {
		return fmt.Errorf("event id %q is not a UUID: %w", key, err)
	}

	_, err = r.session.Query(
		fmt.Sprintf(
			"INSERT INTO %v (id, name) VALUES (?, ?) IF NOT EXISTS",
			tableName,
		),
		id,
		name,
	).MapScanCASContext(ctx, map[string]any{})
	return err
}

{{end}}func (r *Repository) Update(ctx context.Context, id string, newName string) error {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return domain.ErrUserNotFound
	}

	// IF EXISTS turns the write into a lightweight transaction. Without it a
	// Cassandra UPDATE is an upsert: updating an id that was never inserted
	// silently creates the row and reports success, so a caller could never
	// see "no such user". The CAS [applied] flag says whether the row existed;
	// the LWT round-trip is the price of it.
	applied, err := r.session.Query(
		fmt.Sprintf(
			"UPDATE %v SET name = ? WHERE id = ? IF EXISTS",
			tableName,
		),
		newName,
		id,
	).MapScanCASContext(ctx, map[string]any{})

	if err != nil {
		return err
	}
	if !applied {
		return domain.ErrUserNotFound
	}

	return nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return domain.ErrUserNotFound
	}

	// IF EXISTS for the same reason as Update: a bare Cassandra DELETE always
	// "succeeds" (it just writes a tombstone), so a missing row could never
	// surface as not-found.
	applied, err := r.session.Query(
		fmt.Sprintf(
			"DELETE FROM %v WHERE id = ? IF EXISTS",
			tableName,
		),
		id,
	).MapScanCASContext(ctx, map[string]any{})

	if err != nil {
		return err
	}
	if !applied {
		return domain.ErrUserNotFound
	}

	return nil
}

func (r *Repository) Fetch(ctx context.Context, id string) (domain.User, error) {
	// The id column is a UUID; a malformed id can never match a row.
	if _, err := gocql.ParseUUID(id); err != nil {
		return domain.User{}, domain.ErrUserNotFound
	}

	var user domain.User
	err := r.session.Query(
		fmt.Sprintf("SELECT id, name FROM %v WHERE id = ?", tableName),
		id,
	).Consistency(gocql.One).ScanContext(ctx, &user.ID, &user.Name)

	if err != nil {
		if errors.Is(err, gocql.ErrNotFound) {
			return domain.User{}, domain.ErrUserNotFound
		}
		return domain.User{}, fmt.Errorf("error fetching data: %w", err)
	}

	return user, nil
}

func (r *Repository) FetchAll(ctx context.Context, limit int, cursor string) (domain.Page, error) {
	// Self-defense: the service always clamps limit into [1, max]. Guard anyway —
	// gocql's PageSize(n) *disables* paging when n <= 0, which would reintroduce
	// the unbounded scan this feature exists to prevent.
	if limit < 1 {
		limit = 1
	}

	// Apache Cassandra has no OFFSET (CASSANDRA-6511, Won't Fix); it pages
	// natively via an opaque driver "paging state". The cursor is that state,
	// base64-encoded. We therefore drop the auto-paging Scanner() and drive the
	// iterator a single page at a time with PageSize + PageState.
	var pageState []byte
	if cursor != "" {
		decoded, err := base64.RawURLEncoding.DecodeString(cursor)
		if err != nil {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		pageState = decoded
	}

	iter := r.session.Query(
		fmt.Sprintf(
			"SELECT id, name FROM %s",
			tableName,
		),
	).PageSize(limit).PageState(pageState).IterContext(ctx)

	var users []domain.User
	var user domain.User
	for iter.Scan(&user.ID, &user.Name) {
		users = append(users, user)
	}

	// PageState() must be read before Close(); an empty state means no more rows.
	nextPageState := iter.PageState()
	if err := iter.Close(); err != nil {
		// A paging state is opaque driver bytes, so unlike the keyset stores it
		// cannot be validated up front: Cassandra only rejects a forged one at
		// execution, as a protocol violation by the client message (0x000A).
		// That is a client error, not a server fault. Scope the mapping to a
		// supplied cursor so a genuine protocol fault still surfaces as 500.
		var reqErr gocql.RequestError
		if cursor != "" && errors.As(err, &reqErr) && reqErr.Code() == gocql.ErrCodeProtocol {
			return domain.Page{}, domain.ErrInvalidCursor
		}
		return domain.Page{}, err
	}

	page := domain.Page{Items: users}
	if len(nextPageState) > 0 {
		page.NextCursor = base64.RawURLEncoding.EncodeToString(nextPageState)
	}

	return page, nil
}
