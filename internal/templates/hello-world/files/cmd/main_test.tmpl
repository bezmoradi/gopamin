package main

import (
	"os"
	"path/filepath"
	"testing"

	"{{.Name}}/configs"
)

func TestProjectName(t *testing.T) {
	t.Run("return project name", func(t *testing.T) {
		// The test brings its own .env: the project's is gitignored, so a clean
		// checkout (CI) has none.
		dir := t.TempDir()
		if err := os.WriteFile(filepath.Join(dir, ".env"), []byte("PROJECT_NAME={{.Name}}\n"), 0o600); err != nil {
			t.Fatal(err)
		}
		t.Chdir(dir)
		configs.LoadEnv()

		if got := projectName(); got != "{{.Name}}" {
			t.Fatalf("expected {{.Name}} but got %v", got)
		}
	})
}
