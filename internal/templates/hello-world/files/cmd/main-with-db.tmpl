package main

import (
	"context"
	"fmt"

	"{{.Name}}/configs"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/adapters/repositories/{{.Database}}"
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/ports"
	"{{.Name}}/internal/core/user/services"
)

func init() {
	configs.LoadEnv()
}

func insert(us ports.UserServiceInterface, logger shared.Logger, value string) {
	lastInsertID, err := us.Create(context.Background(), value)
	if err != nil {
		logger.Fatal(err)
	}
	logger.Info(fmt.Sprintf("last inserted ID: %v", lastInsertID))
}

func fetch(us ports.UserServiceInterface, logger shared.Logger, id string) {
	user, err := us.Show(context.Background(), id)
	if err != nil {
		logger.Fatal(err)
	}

	json, err := user.ToJson()
	if err != nil {
		logger.Fatal(err)
	}

	logger.Info(json)
}

func update(us ports.UserServiceInterface, logger shared.Logger, id string, newName string) {
	rowsAffected, err := us.Update(context.Background(), id, newName)
	if err != nil {
		logger.Fatal(err)
	}
	logger.Info(fmt.Sprintf("rows effected: %v", rowsAffected))
}

func deleteUser(us ports.UserServiceInterface, logger shared.Logger, id string) {
	rowsAffected, err := us.Delete(context.Background(), id)
	if err != nil {
		logger.Fatal(err)
	}
	logger.Info(fmt.Sprintf("rows effected: %v", rowsAffected))
}

func fetchAll(us ports.UserServiceInterface, logger shared.Logger) {
	users, err := us.Index(context.Background())
	if err != nil {
		logger.Fatal(err)
	}

	for _, user := range users {
		json, err := user.ToJson()
		if err != nil {
			logger.Fatal(err)
		}
		logger.Info(json)
	}
}


func main() {
	logger := {{.Logger}}.New()
	db, err := {{.Database}}.New(logger)
	if err != nil {
		logger.Fatal(err)
	}
	us := services.NewUserService(db)

	// Step 1) Uncomment the following line to add new values to the DB
	// insert(us, logger, "John Doe")

	// Step 2) Uncomment the following line to fetch by ID
	// fetch(us, logger, "<record_id>")

	// Step 3) Uncomment the following line to update
	// update(us, logger, "<record_id>", "Jane Doe")

	// Step 4) Uncomment the following line to delete
	// deleteUser(us, logger, "<record_id>")

	fetchAll(us, logger)
}
