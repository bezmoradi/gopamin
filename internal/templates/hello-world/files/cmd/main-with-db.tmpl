package main

import (
	"context"
	"encoding/json"
	"fmt"

	"{{.Name}}/configs"
	"{{.Name}}/internal/adapters/loggers/{{.Logger}}"
	"{{.Name}}/internal/adapters/repositories/{{.Database}}"
	"{{.Name}}/internal/core/shared"
	"{{.Name}}/internal/core/user/ports"
	"{{.Name}}/internal/core/user/services"
)

func init() {
	configs.LoadEnv()
}

// userPayload is this demo's JSON shape. The domain entity carries no wire-format
// tags, so the composition root owns how a user is serialized for output.
type userPayload struct {
	Id   string `json:"id"`
	Name string `json:"name"`
}

func insert(us ports.UserServiceInterface, logger shared.Logger, value string) {
	lastInsertID, err := us.Create(context.Background(), value)
	if err != nil {
		logger.Fatal(err)
	}
	logger.Info(fmt.Sprintf("last inserted ID: %v", lastInsertID))
}

func fetch(us ports.UserServiceInterface, logger shared.Logger, id string) {
	user, err := us.Show(context.Background(), id)
	if err != nil {
		logger.Fatal(err)
	}

	data, err := json.Marshal(userPayload{Id: user.Id, Name: user.Name})
	if err != nil {
		logger.Fatal(err)
	}

	logger.Info(string(data))
}

func update(us ports.UserServiceInterface, logger shared.Logger, id string, newName string) {
	user, err := us.Update(context.Background(), id, newName)
	if err != nil {
		logger.Fatal(err)
	}
	logger.Info("user updated", "id", user.Id, "name", user.Name)
}

func deleteUser(us ports.UserServiceInterface, logger shared.Logger, id string) {
	if err := us.Delete(context.Background(), id); err != nil {
		logger.Fatal(err)
	}
	logger.Info("user deleted", "id", id)
}

func fetchAll(us ports.UserServiceInterface, logger shared.Logger) {
	// This demo just prints the first page; pass page.NextCursor back as the
	// third argument to walk subsequent pages.
	page, err := us.Index(context.Background(), 0, "")
	if err != nil {
		logger.Fatal(err)
	}

	for _, user := range page.Items {
		data, err := json.Marshal(userPayload{Id: user.Id, Name: user.Name})
		if err != nil {
			logger.Fatal(err)
		}
		logger.Info(string(data))
	}
}


func main() {
	logger := {{.Logger}}.New()
	db, err := {{.Database}}.New()
	if err != nil {
		logger.Fatal(err)
	}
	defer func() { _ = db.Close() }()
	us := services.NewUserService(db)

	// fetchAll runs below. The other helpers show the remaining operations — swap in
	// a call to try one:
	//   insert(us, logger, "John Doe")
	//   fetch(us, logger, "<record_id>")
	//   update(us, logger, "<record_id>", "Jane Doe")
	//   deleteUser(us, logger, "<record_id>")
	// The blank assignment keeps them referenced so `make lint` stays clean until used.
	_, _, _, _ = insert, fetch, update, deleteUser

	fetchAll(us, logger)
}
